@page "/Admin/Backup/Targets"
@model MatMail.Pages.Admin.Backup.TargetsModel
@{
    ViewData["Breadcrumb"] = "Administration / Backups / Targets";
    ViewData["Title"] = L["Backups"].Value;
    ViewData["Description"] = L["A target is a place for backups: a folder of this server (a mounted disk or share) or a folder on a network share (NAS) that MatMail reaches itself."].Value;
}

<partial name="_BackupTabs" model='"targets"' />

<mm-list>
<mm-toolbar count="Model.Paged.Total">
    <mm-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Search targets…"]' />
    <mm-toolbar-select name="Kind" label='@L["Type"]' value="@Model.Kind">
        <option value="">@L["All"]</option>
        <option value="local">@L["Folder of this server"]</option>
        <option value="smb">@L["Network share (SMB)"]</option>
    </mm-toolbar-select>
    <mm-toolbar-select name="Sort" label='@L["Sort"]' value="@Model.Sort">
        <option value="name_asc">@L["Name (A–Z)"]</option>
        <option value="name_desc">@L["Name (Z–A)"]</option>
    </mm-toolbar-select>
</mm-toolbar>

<mm-table item-count="Model.Paged.Rows.Count" empty-text='@L["No target yet. Add the folder or the share the backups should go to."]' empty-icon="hard-drive">
    <thead>
        <tr>
            <th>@L["Name"]</th>
            <th class="mat-hide-sm">@L["Type"]</th>
            <th>@L["Where"]</th>
            <th class="mat-hide-sm">@L["Last check"]</th>
            <th class="mat-hide-sm mat-num">@L["Schedules"]</th>
            <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var target in Model.Paged.Rows)
        {
            <tr data-row-href="/Admin/Backup/Target?id=@target.Id">
                <td>
                    <div class="mat-table__name"><span><a href="/Admin/Backup/Target?id=@target.Id">@target.Name</a> @if (!target.IsActive) { <mm-badge kind="muted">@L["Disabled"]</mm-badge> }</span></div>
                </td>
                <td class="mat-hide-sm">
                    @if (target.Kind == BackupTargetKind.Smb) { <mm-badge kind="info" icon="network">@L["Network share (SMB)"]</mm-badge> }
                    else { <mm-badge kind="muted" icon="folder">@L["Folder of this server"]</mm-badge> }
                </td>
                <td class="mat-mono mat-text-break">@TargetsModel.Where(target)</td>
                <td class="mat-hide-sm">
                    <div>
                        @if (target.LastCheckOk is true)
                        {
                            <mm-badge kind="ok">@L["Succeeded"]</mm-badge>
                            <small class="mat-muted mat-mono mat-d-block">@Fmt.Ago(target.LastCheckDate)</small>
                        }
                        else if (target.LastCheckOk is false)
                        {
                            <mm-badge kind="danger">@L["Failed"]</mm-badge>
                            <small class="mat-muted mat-d-block">@target.LastCheckMessage</small>
                        }
                        else { <span class="mat-muted">–</span> }
                    </div>
                </td>
                <td class="mat-hide-sm mat-num">@(Model.PlanCounts.GetValueOrDefault(target.Id))</td>
                <td class="mat-table__cell-actions">
                    <div class="mat-table__actions">
                        <mm-button variant="ghost" href='@($"/Admin/Backup/Target?id={target.Id}")' icon="edit" icon-only="true" small="true">@L["Edit"]</mm-button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</mm-table>

<mm-pagination current-page="Model.Paged.PageNumber" total-pages="Model.Paged.TotalPages" total-count="Model.Paged.Total" page-size="Model.Paged.PageSize" />

<mm-list-actions>
    <mm-button variant="primary" href="/Admin/Backup/Target" icon="plus">@L["New target"]</mm-button>
</mm-list-actions>
</mm-list>
