@model string
@* The tabs of the server settings; Model = key of the active tab. *@
<mm-tabbar>
    <mm-tab title='@L["Server settings"]' href="/Platform/Settings" icon="settings" active='@(Model == "settings")' />
    <mm-tab title='@L["TLS certificate"]' href="/Platform/Settings/Certificate" icon="lock" active='@(Model == "certificate")' />
</mm-tabbar>
