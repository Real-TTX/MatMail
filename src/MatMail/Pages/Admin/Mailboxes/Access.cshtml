@page "/Admin/Mailboxes/Access"
@model MatMail.Pages.Admin.Mailboxes.AccessModel
@{
    ViewData["Breadcrumb"] = "Administration / Mailboxes / Delegation";
    ViewData["Title"] = Model.MailboxName;
    ViewData["Width"] = "narrow";
}

<partial name="_MailboxTabs" model='(Model.Id, "access")' />

@* The explanation of the tab stands under the tabs, not in the page head: the tab bar keeps its place when one moves from tab to tab. *@
<p class="mat-muted">
    @(Model.IsShared
        ? L["The users listed here work in this shared mailbox (public folder), for example everybody who answers info@."]
        : L["The owner always has full access. Users listed here may also work in this mailbox, for example as a substitute."])
</p>

<mm-list>
    <mm-table item-count="Model.Permissions.Count" empty-text='@L["Nobody else has access to this mailbox."]' empty-icon="users">
        <thead>
            <tr>
                <th>@L["User"]</th>
                <th>@L["Access"]</th>
                <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var permission in Model.Permissions)
            {
                <tr data-row-href="/Admin/Mailboxes/Delegate?mailboxId=@Model.Id&id=@permission.Id">
                    <td>
                        <div class="mat-table__name"><span><a href="/Admin/Mailboxes/Delegate?mailboxId=@Model.Id&id=@permission.Id">@permission.UserName</a><small>@permission.LoginName</small></span></div>
                    </td>
                    <td><mm-badge kind="@(permission.Access >= MailboxAccess.Send ? "warn" : "info")">@Model.AccessLabel(permission.Access)</mm-badge></td>
                    <td class="mat-table__cell-actions">
                        <div class="mat-table__actions">
                            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Admin/Mailboxes/Delegate?mailboxId=@Model.Id&id=@permission.Id" data-tip="@L["Edit"]" aria-label="@L["Edit"]"><mm-icon name="edit" /></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </mm-table>

    <mm-list-actions>
        <mm-button variant="primary" href="@($"/Admin/Mailboxes/Delegate?mailboxId={Model.Id}")" icon="user-plus">@L["Add user"]</mm-button>
        <mm-button variant="secondary" href="/Admin/Mailboxes" icon="back">@L["Back"]</mm-button>
    </mm-list-actions>
</mm-list>
