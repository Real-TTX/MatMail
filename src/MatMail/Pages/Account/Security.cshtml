@page "/Account/Security"
@model MatMail.Pages.Account.SecurityModel
@{
    ViewData["Breadcrumb"] = "Account / Security";
    ViewData["Title"] = L["Security"].Value;
    ViewData["Width"] = "narrow";
    TwoFactorStatus status = Model.Status;
    bool setUpRunning = Model.Overview.PendingSecret is not null;
}

@* Several forms stand on this page, one for every thing that can be done. They are plain forms of the toolkit (mat-form) and not mm-form, because mm-form
   draws the summary of ALL errors of the page above every form: with the password of one form wrong, every card would announce it. The error stands at its field. *@

@if (status.SetupRequired)
{
    <mm-alert kind="warn">@L["Two-factor authentication is required for your account. Set it up now: everything else stays closed until you have."]</mm-alert>
}

@* ---- What is shown only once: the recovery codes and a new app password ---- *@
@if (Model.NewRecoveryCodes is { Count: > 0 } recoveryCodes)
{
    string codeText = string.Join("\n", recoveryCodes);
    string downloadHref = "data:text/plain;charset=utf-8," + Uri.EscapeDataString(codeText + "\n");
    <mm-card title='@L["Your recovery codes"]' icon="key" accent="true" role="alert">
        <p>@L["Keep these codes in a safe place, for example in a password manager. Each code works once, in place of the code of the app. They are shown only now."]</p>
        <ul class="mm-code-grid">
            @foreach (string code in recoveryCodes)
            {
                <li class="mm-code-grid__item mat-mono">@code</li>
            }
        </ul>
        <div class="mat-row">
            <mm-button variant="secondary" type="button" icon="copy" data-copy="@codeText">@L["Copy"]</mm-button>
            <mm-button variant="secondary" href="@downloadHref" icon="download" download="matmail-recovery-codes.txt">@L["Download"]</mm-button>
        </div>
    </mm-card>
}

@if (Model.CreatedAppPassword is { } created)
{
    string createdTitle = string.Format(L["App password “{0}”"].Value, Model.CreatedAppPasswordName);
    <mm-card title="@createdTitle" icon="key" accent="true" role="alert">
        <p>@L["Enter this instead of your password in the mail program (IMAP and SMTP). It is shown only now. If you lose it, revoke it and create a new one."]</p>
        <div class="mat-input-group">
            <input class="mat-input mat-mono" id="created-app-password" value="@created" readonly aria-label="@createdTitle" />
            <mm-button variant="secondary" type="button" icon="copy" data-copy="#created-app-password">@L["Copy"]</mm-button>
        </div>
    </mm-card>
}

@* ---- The authenticator app ---- *@
@if (status.Enabled)
{
    <mm-card title='@L["Authenticator app"]' icon="smartphone">
        <p class="mat-muted">@L["Signing in asks for a code from your authenticator app after the password. For a new phone, turn it off and set it up again."]</p>
        <dl class="mat-kv">
            <dt>@L["Status"]</dt>
            <dd><mm-badge kind="ok">@L["On"]</mm-badge> @if (status.Required) { <mm-badge kind="info">@L["Required for your account"]</mm-badge> }</dd>
            <dt>@L["On since"]</dt>
            <dd>@Fmt.DateTimeText(Model.Overview.EnabledSince)</dd>
            <dt>@L["Recovery codes left"]</dt>
            <dd>@Model.Overview.RecoveryCodesLeft @if (Model.Overview.RecoveryCodesLeft <= 2) { <mm-badge kind="warn">@L["Create new ones soon"]</mm-badge> }</dd>
        </dl>
    </mm-card>

    <form class="mat-form" method="post" asp-page-handler="Renew" novalidate>
        <mm-form-section title='@L["Recovery codes"]' icon="key" columns="2"
                         description='@L["If you lose your phone, a recovery code takes the place of the code of the app. Creating new codes makes the old ones worthless."]'>
            <mm-field asp-for="Renew.Password" kind="password" label='@L["Your password"]' autocomplete="current-password" />
            <mm-field asp-for="Renew.Code" label='@L["Code of the app or a recovery code"]' autocomplete="one-time-code" autocapitalize="none" spellcheck="false" />
        </mm-form-section>
        <mm-button-row>
            <mm-button variant="secondary" type="submit" icon="refresh">@L["Create new recovery codes"]</mm-button>
        </mm-button-row>
    </form>

    <form class="mat-form" method="post" asp-page-handler="Disable" novalidate>
        <mm-form-section title='@L["Turn off two-factor authentication"]' icon="x-circle" columns="2"
                         description='@(status.Required ? L["Your account is bound to two-factor authentication: after turning it off you have to set it up again at once."].Value : L["Signing in needs the password alone again, and mail programs may use your password."].Value)'>
            <mm-field asp-for="Disable.Password" kind="password" label='@L["Your password"]' autocomplete="current-password" />
            <mm-field asp-for="Disable.Code" label='@L["Code of the app or a recovery code"]' autocomplete="one-time-code" autocapitalize="none" spellcheck="false" />
        </mm-form-section>
        <mm-button-row>
            <mm-button variant="danger" type="submit" icon="x-circle" confirm='@L["Turn off two-factor authentication?"]' confirm-ok='@L["Turn off"]'>@L["Turn off"]</mm-button>
        </mm-button-row>
    </form>
}
else if (setUpRunning)
{
    <form class="mat-form" method="post" asp-page-handler="Confirm" novalidate>
        <mm-form-section title='@L["Set up the authenticator app"]' icon="smartphone"
                         description='@L["Two steps: add this account to an authenticator app (Google Authenticator, Microsoft Authenticator, Aegis, 1Password …), then enter the code it shows."]'>
            <div class="mm-setup">
                <div class="mm-qr" role="img" aria-label="@L["QR code for your authenticator app"]">@Html.Raw(Model.SetupQr)</div>
                <div class="mm-setup__key mat-stack mat-stack--sm">
                    <h3 class="mat-fs-md">@L["1. Add the account"]</h3>
                    <p class="mat-muted">@L["Scan the QR code with the app. Cannot scan it? Enter this key in the app (type: time based):"]</p>
                    <p class="mm-secret">@Model.SetupSecret</p>
                    <div class="mat-row">
                        <mm-button variant="secondary" type="button" small="true" icon="copy" data-copy="@Model.Overview.PendingSecret">@L["Copy the key"]</mm-button>
                        <mm-button variant="secondary" small="true" icon="smartphone" href="@Model.SetupUri">@L["Open in the app on this device"]</mm-button>
                    </div>
                </div>
            </div>
            <h3 class="mat-fs-md">@L["2. Enter the code"]</h3>
            <mm-field asp-for="Enrol.Code" label='@L["Code of the app"]' autocomplete="one-time-code" autofocus="autofocus" placeholder="123 456"
                      help='@L["The app shows a new 6-digit code every 30 seconds."]' />
        </mm-form-section>
        <mm-button-row>
            <mm-button variant="primary" type="submit" icon="check">@L["Turn on"]</mm-button>
            <mm-button variant="secondary" handler="Cancel" icon="x">@L["Cancel"]</mm-button>
        </mm-button-row>
    </form>
}
else
{
    <form class="mat-form" method="post" asp-page-handler="Start" novalidate>
        <mm-form-section title='@L["Authenticator app"]' icon="smartphone"
                         description='@L["A second step after the password: a 6-digit code from an app on your phone. Someone who knows your password cannot sign in without it."]'>
            <dl class="mat-kv">
                <dt>@L["Status"]</dt>
                <dd><mm-badge kind="muted">@L["Off"]</mm-badge> @if (status.Required) { <mm-badge kind="warn">@L["Required for your account"]</mm-badge> }</dd>
            </dl>
            <mm-field asp-for="Start.Password" kind="password" label='@L["Your password"]' autocomplete="current-password"
                      help='@L["Asked once more, so that nobody who only holds your open session can set up a second factor of their own."]' />
        </mm-form-section>
        <mm-button-row>
            <mm-button variant="primary" type="submit" icon="smartphone">@L["Set up the authenticator app"]</mm-button>
        </mm-button-row>
    </form>
}

@* ---- App passwords for mail programs ---- *@
@if (Model.CanCreateAppPasswords)
{
    <mm-card title='@L["App passwords"]' icon="key">
        <p class="mat-muted">
            @if (status.ProtocolsNeedAppPassword)
            {
                @L["Mail programs such as Outlook, Thunderbird or your phone cannot ask for a code. Create an app password for each of them and enter it instead of your password. Your password itself does not work in mail programs while two-factor authentication is on or required."]
            }
            else
            {
                @L["A password of its own for each mail program, which you can revoke one by one. Once two-factor authentication is on, mail programs need one, because they cannot ask for a code."]
            }
        </p>

        <mm-list>
            <mm-table item-count="Model.AppPasswords.Count" empty-text='@L["No app passwords yet."]' empty-icon="key">
                <thead>
                    <tr>
                        <th>@L["Name"]</th>
                        <th class="mat-hide-sm">@L["Created"]</th>
                        <th>@L["Last used"]</th>
                        <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (AppPassword appPassword in Model.AppPasswords)
                    {
                        <tr>
                            <td>
                                <div class="mat-table__name"><span>@appPassword.Name<small class="mat-mono">@appPassword.Prefix …</small></span></div>
                            </td>
                            <td class="mat-hide-sm">@Fmt.DateText(appPassword.CreateDate)</td>
                            <td>
                                @if (appPassword.LastUsedDate is { } lastUsed)
                                {
                                    <span>@Fmt.Ago(lastUsed)</span>
                                    @if (!string.IsNullOrEmpty(appPassword.LastUsedIp))
                                    {
                                        <span class="mat-muted mat-mono mat-d-block">@appPassword.LastUsedIp</span>
                                    }
                                }
                                else
                                {
                                    <span class="mat-muted">@L["Never"]</span>
                                }
                            </td>
                            <td class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    <form method="post" asp-page-handler="RevokeAppPassword" data-no-busy>
                                        <input type="hidden" name="token" value="@appPassword.Token" />
                                        <button type="submit" class="mat-btn mat-btn--danger mat-btn--icon mat-btn--sm" data-tip="@L["Revoke"]" aria-label="@L["Revoke"]"
                                                data-confirm="@string.Format(L["Revoke the app password “{0}”? Mail programs that use it stop working."].Value, appPassword.Name)" data-confirm-ok="@L["Revoke"]">
                                            <mm-icon name="trash" />
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </mm-table>

            <mm-list-actions>
                <mm-button variant="primary" type="button" icon="plus" data-dialog-open="new-app-password">@L["New app password"]</mm-button>
            </mm-list-actions>
        </mm-list>
    </mm-card>

    <mm-dialog id="new-app-password" title='@L["New app password"]' icon="key" size="sm">
        <form id="new-app-password-form" class="mat-form" method="post" asp-page-handler="CreateAppPassword" novalidate>
            <mm-field asp-for="NewAppPassword.Name" label='@L["Name"]' placeholder='@L["Thunderbird on my laptop"]' autocomplete="off"
                      help='@L["What it is used for, so you can tell the passwords apart."]' />
            <mm-field asp-for="NewAppPassword.Password" kind="password" label='@L["Your password"]' autocomplete="current-password"
                      help='@L["Asked again because an app password signs in without a code."]' />
        </form>
        <mm-dialog-foot>
            <mm-button variant="primary" type="submit" icon="key" form="new-app-password-form">@L["Create app password"]</mm-button>
            <mm-button variant="secondary" type="button" data-dialog-close="data-dialog-close">@L["Cancel"]</mm-button>
        </mm-dialog-foot>
    </mm-dialog>
}

@section Scripts {
    <script src="~/js/account-security.js" asp-append-version="true"></script>
}
