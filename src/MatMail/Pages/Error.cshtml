@page "/Error"
@model MatMail.Pages.ErrorModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = L["Something went wrong"].Value;
}

<div class="mat-auth__card">
    <partial name="_AuthBrand" />
    <div class="mat-stack mat-stack--sm">
        <h1>@(Model.Code == 404 ? L["Page not found"] : L["Something went wrong"])</h1>
        <p class="mat-muted">@(Model.Code == 404 ? L["This page does not exist."] : L["The request could not be completed. Please try again."])</p>
    </div>
    <mm-button-row>
        <mm-button variant="primary" href="/" icon="home">@L["Back to start"]</mm-button>
    </mm-button-row>
</div>
