@page "/Admin/Backup"
@model MatMail.Pages.Admin.Backup.IndexModel
@{
    ViewData["Breadcrumb"] = "Administration / Backups";
    ViewData["Title"] = L["Backups"].Value;
    ViewData["Description"] = L["Everything of this installation – the database and the files of the data volume – is backed up as a whole, so that it can be restored on any server. Backups are made on a schedule to a folder or to a network share (NAS)."].Value;
}

<partial name="_BackupTabs" model='"overview"' />

<script type="application/json" id="backup-i18n">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Texts))</script>

@if (Model.Report is { } report)
{
    <mm-alert kind='@(report.Succeeded ? "ok" : "danger")' title='@(report.Succeeded ? L["A backup was restored."].Value : L["The restore failed. Nothing was changed."].Value)'>
        @if (report.Succeeded)
        {
            @if (report.BackupCreatedUtc is not null || report.BackupVersion is not null)
            {
                <span>@(report.BackupCreatedUtc is null ? string.Empty : string.Format(L["It was made on {0}"].Value, Fmt.DateTimeText(report.BackupCreatedUtc)))@(report.BackupVersion is null ? string.Empty : " (" + report.BackupVersion + ")").</span>
            }

            @if (!string.IsNullOrEmpty(report.SafetyBackup))
            {
                <span>@string.Format(L["The state before is saved as {0}."].Value, report.SafetyBackup)</span>
            }
        }
        else
        {
            <span>@report.Message</span>
        }

        <span class="mat-muted mat-mono">@Fmt.DateTimeText(report.FinishedUtc)</span>
        <div class="mat-alert__actions">
            <form method="post" asp-page-handler="Dismiss" data-no-busy>
                <mm-button variant="secondary" type="submit" small="true" icon="x">@L["Dismiss"]</mm-button>
            </form>
        </div>
    </mm-alert>
}

@foreach ((NoticeKind kind, string text) in Model.Warnings)
{
    <mm-alert kind='@(kind == NoticeKind.Danger ? "danger" : "warn")'>@text</mm-alert>
}

@* The run that is going on: the script (backup.js) shows it while it runs and reloads the page when it is over. *@
<mm-card id="backup-activity" title='@L["A backup is running"]' icon="refresh" data-status-url="@Url.Page("/Admin/Backup/Index", "Status")" data-running="@(Model.Activity is null ? "false" : "true")" hidden="@(Model.Activity is null)">
    <div class="mat-meter" id="backup-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-label="@L["Progress"]"><div class="mat-meter__fill"></div></div>
    <p class="mat-muted" id="backup-activity-text">@(Model.Activity?.Stage)</p>
    <form method="post" asp-page-handler="Cancel" data-no-busy>
        <mm-button variant="secondary" type="submit" icon="x">@L["Cancel"]</mm-button>
    </form>
</mm-card>

<mm-list>
<mm-toolbar count="Model.Paged.Total">
    <mm-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Search backups…"]' />
    <mm-toolbar-select name="Status" label='@L["Result"]' value="@Model.Status">
        <option value="">@L["All"]</option>
        <option value="succeeded">@L["Succeeded"]</option>
        <option value="failed">@L["Failed"]</option>
    </mm-toolbar-select>
    <mm-toolbar-select name="Sort" label='@L["Sort"]' value="@Model.Sort">
        <option value="date_desc">@L["Newest first"]</option>
        <option value="date_asc">@L["Oldest first"]</option>
        <option value="size_desc">@L["Largest first"]</option>
    </mm-toolbar-select>
</mm-toolbar>

<mm-table item-count="Model.Paged.Rows.Count" empty-text='@L["No backup was made yet."]' empty-icon="archive">
    <thead>
        <tr>
            <th>@L["When"]</th>
            <th>@L["Schedule"]</th>
            <th class="mat-hide-sm">@L["Target"]</th>
            <th class="mat-hide-sm mat-num">@L["Size"]</th>
            <th class="mat-hide-sm mat-num">@L["Duration"]</th>
            <th>@L["Result"]</th>
            <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var run in Model.Paged.Rows)
        {
            <tr>
                <td>
                    <div>
                        <span class="mat-mono mat-nowrap">@Fmt.DateTimeText(run.StartedDate)</span>
                        @if (run.Kind == BackupRunKind.Manual) { <small class="mat-muted mat-d-block">@L["manual run"]</small> }
                    </div>
                </td>
                <td>@run.PlanName</td>
                <td class="mat-hide-sm">@run.TargetName</td>
                <td class="mat-hide-sm mat-num mat-nowrap">
                    <span>@(run.Bytes is null ? "–" : Fmt.Size(run.Bytes.Value))@if (run.Encrypted) { <span class="mat-muted" role="img" aria-label="@L["Encrypted"]" data-tip="@L["Encrypted"]"> <mm-icon name="lock" /></span> }</span>
                </td>
                <td class="mat-hide-sm mat-num mat-nowrap">@(run.FinishedDate is null ? "–" : (run.FinishedDate.Value - run.StartedDate).ToString(@"m\:ss"))</td>
                <td>
                    <div>
                        @if (run.Status == BackupRunStatus.Succeeded)
                        {
                            <mm-badge kind="ok">@L["Succeeded"]</mm-badge>
                            @if (!string.IsNullOrEmpty(run.Message)) { <small class="mat-muted mat-d-block">@run.Message</small> }
                        }
                        else
                        {
                            <mm-badge kind="danger">@L["Failed"]</mm-badge>
                            <small class="mat-muted mat-d-block">@run.Message</small>
                        }
                    </div>
                </td>
                <td class="mat-table__cell-actions">
                    @if (run.Status == BackupRunStatus.Succeeded && run.FileName is not null && run.TargetId is not null)
                    {
                        <div class="mat-table__actions">
                            <mm-button variant="ghost" href='@($"/Admin/Backup/Restore?handler=File&target={run.TargetId}&file={Uri.EscapeDataString(run.FileName)}")' icon="download" icon-only="true" small="true">@L["Download"]</mm-button>
                            <mm-button variant="ghost" href='@($"/Admin/Backup/RestoreConfirm?target={run.TargetId}&file={Uri.EscapeDataString(run.FileName)}")' icon="restore" icon-only="true" small="true">@L["Restore this backup"]</mm-button>
                        </div>
                    }
                </td>
            </tr>
        }
    </tbody>
</mm-table>

<mm-pagination current-page="Model.Paged.PageNumber" total-pages="Model.Paged.TotalPages" total-count="Model.Paged.Total" page-size="Model.Paged.PageSize" />

<mm-list-actions>
    @if (Model.PlanItems.Count > 0)
    {
        <form method="post" asp-page-handler="Run" class="mat-form mat-form--inline" data-no-busy>
            <div class="mat-field mat-field--auto">
                <label class="mat-sr-only" for="backup-plan">@L["Schedule"]</label>
                <select class="mat-select" id="backup-plan" name="planId">
                    @foreach (var item in Model.PlanItems) { <option value="@item.Value">@item.Text</option> }
                </select>
            </div>
            <div class="mat-field mat-field--auto">
                <mm-button variant="primary" type="submit" icon="play">@L["Back up now"]</mm-button>
            </div>
        </form>
    }
    <mm-button variant="secondary" href="/Admin/Backup/Download" icon="download">@L["Download a backup"]</mm-button>
    <mm-button variant="secondary" href="/Admin/Backup/Plan" icon="plus">@L["New schedule"]</mm-button>
</mm-list-actions>
</mm-list>

@section Scripts {
    <script src="~/js/backup.js" asp-append-version="true"></script>
}
