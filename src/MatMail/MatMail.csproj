<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>MatMail</RootNamespace>
    <AssemblyName>MatMail</AssemblyName>
    <UserSecretsId>matmail</UserSecretsId>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MsgReader" Version="6.1.4" />
    <PackageReference Include="Novell.Directory.Ldap.NETStandard" Version="4.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <!-- Pinned to the same version as the design-time package, so the tests resolve one consistent EF Core -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- IMAP / POP3 / SMTP client (provider sync + relay) and MIME parsing -->
    <PackageReference Include="MailKit" Version="4.*" />
    <!-- Sanitizes HTML mail bodies before they are shown in the web client -->
    <PackageReference Include="HtmlSanitizer" Version="9.*" />
    <!-- MX lookups for direct delivery -->
    <PackageReference Include="DnsClient" Version="1.*" />
    <!-- Draws the QR code of the authenticator app set-up as SVG (pure managed, no external service) -->
    <PackageReference Include="QRCoder" Version="1.*" />
    <PackageReference Include="SMBLibrary" Version="1.5.7.1" />
    <!-- MatPlatform (the copy in MatPlatform/): the bearer tokens of MatIdentity on /api and the sign-in through MatIdentity -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <!-- Newer than what the two above bring along (10.0.12 has known vulnerabilities). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MatMail.Tests" />
  </ItemGroup>

</Project>
