@model (MatMail.Pages.Account.Rules.RuleLabels Labels, MatMail.Pages.Account.Rules.EditModel.ConditionInput Row, string Index)
@* One condition of a rule. The names are Input.Conditions[n].…; rules.js adds and removes rows and renumbers them (names and ids). *@
@{
    var c = Model.Row;
    string prefix = $"Input.Conditions[{Model.Index}]";
    string id = $"rule-condition-{Model.Index}";
    bool isBool = c.Field == RuleField.HasAttachment;
    bool isHeader = c.Field == RuleField.Header;
    bool isSize = c.Field == RuleField.Size;
}
<div class="mm-rule-row" data-rule-row="condition">
    <select class="mat-select" id="@(id)-field" name="@(prefix).Field" data-role="field" aria-label="@L["Field"]">
        @foreach (var item in Model.Labels.FieldItems())
        {
            <option value="@item.Value" selected="@(item.Value == c.Field.ToString())">@item.Text</option>
        }
    </select>
    <input class="mat-input" type="text" id="@(id)-header" name="@(prefix).HeaderName" value="@c.HeaderName" maxlength="100" data-role="header"
           placeholder="@L["Header field, e.g. List-Id"]" aria-label="@L["Header field"]" hidden="@(!isHeader)" disabled="@(!isHeader)" />
    <select class="mat-select" id="@(id)-operator" name="@(prefix).Operator" data-role="operator" aria-label="@L["Condition"]" disabled="@isBool" hidden="@isBool">
        @foreach (var item in Model.Labels.OperatorItems(c.Field))
        {
            <option value="@item.Value" selected="@(item.Value == c.Operator.ToString())">@item.Text</option>
        }
    </select>
    @* A size is typed as text with the number keyboard: the server reads "1,5" as well as "1.5" and says what is wrong, where the browser would block the form without a word. *@
    <input class="mat-input mm-rule-row__value" type="text" id="@(id)-value" name="@(prefix).Value" value="@(isBool ? string.Empty : c.Value)" maxlength="500" data-role="value-text"
           placeholder="@L["Text to look for"]" aria-label="@L["Value"]" inputmode="@(isSize ? "decimal" : null)" hidden="@isBool" disabled="@isBool" />
    <select class="mat-select mm-rule-row__value" id="@(id)-bool" name="@(prefix).Value" data-role="value-bool" aria-label="@L["Value"]" hidden="@(!isBool)" disabled="@(!isBool)">
        @foreach (var item in Model.Labels.YesNoItems())
        {
            <option value="@item.Value" selected="@(item.Value == (c.Value ?? "true"))">@item.Text</option>
        }
    </select>
    <span class="mm-rule-row__unit" data-role="unit" hidden="@(!isSize)">KB</span>
    <mm-button variant="ghost" type="button" icon="x" icon-only="true" small="true" class="mm-rule-row__remove" data-rule-remove="data-rule-remove">@L["Remove"]</mm-button>
</div>
