@page "/Admin/Mailboxes/Delegate"
@model MatMail.Pages.Admin.Mailboxes.DelegateModel
@{
    ViewData["Breadcrumb"] = Model.IsEdit ? "Administration / Mailboxes / Delegation / Edit access" : "Administration / Mailboxes / Delegation / New access";
    ViewData["Title"] = Model.IsEdit ? Model.UserName : L["Add user"].Value;
    ViewData["Width"] = "narrow";

    // What each level of access allows, shown under its name.
    var accessHelp = new Dictionary<string, string>
    {
        [nameof(MailboxAccess.Read)] = L["See folders and messages."].Value,
        [nameof(MailboxAccess.Edit)] = L["Also mark, move and delete messages and write drafts."].Value,
        [nameof(MailboxAccess.Send)] = L["Also send mail from this mailbox’s addresses (as a substitute)."].Value,
        [nameof(MailboxAccess.Manage)] = L["Also manage folders and the other users of this mailbox."].Value,
    };
}

<mm-form>
    <input type="hidden" asp-for="MailboxId" />
    <input type="hidden" asp-for="Id" />

    <mm-form-section title='@L["Access to this mailbox"]' icon="users">
        @if (Model.IsEdit)
        {
            <input type="hidden" asp-for="Input.UserId" />
            <mm-field asp-for="UserName" kind="readonly" label='@L["User"]' />
        }
        else
        {
            <mm-picker asp-for="Input.UserId" asp-items="Model.UserItems" label='@L["User"]' placeholder='@L["Select a user…"]' />
        }

        <fieldset class="mat-field mat-fieldset" id="Input_Access">
            <legend class="mat-legend">@L["Access"]</legend>
            <div class="mat-checks">
                @foreach (var item in Model.AccessItems)
                {
                    <label class="mat-check">
                        <input type="radio" id="Input_Access_@item.Value" name="Input.Access" value="@item.Value" checked="@(Model.Input.Access == item.Value)" />
                        <span class="mat-check__text"><strong>@item.Text</strong><small class="mat-muted">@accessHelp[item.Value]</small></span>
                    </label>
                }
            </div>
        </fieldset>
    </mm-form-section>

    <mm-button-row>
        <mm-button variant="primary" type="submit" icon="save">@L["Save"]</mm-button>
        <mm-button variant="secondary" href="@($"/Admin/Mailboxes/Access?id={Model.MailboxId}")" icon="back">@L["Back"]</mm-button>
        <mm-button-spacer />
        @if (Model.IsEdit)
        {
            <mm-button variant="danger" type="submit" handler="Delete" icon="trash" confirm='@L["Remove the access of this user?"]' confirm-ok='@L["Remove access"]'>@L["Remove access"]</mm-button>
        }
    </mm-button-row>
</mm-form>
