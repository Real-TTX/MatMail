@page "/Account/Appearance"
@model MatMail.Pages.Account.AppearanceModel
@{
    ViewData["Breadcrumb"] = "Account / Appearance";
    ViewData["Title"] = L["Appearance"].Value;
    ViewData["Description"] = L["How MatMail looks for you. The choices follow you to every device you sign in on."].Value;
    ViewData["Width"] = "narrow";
}

@section Head {
    @if (Model.TenantColour is { } colour)
    {
        <link rel="stylesheet" href="/brand/accent.css?c=@colour.TrimStart('#')" />
    }
}

<mm-form>
    <mm-form-section title='@L["Look"]' icon="palette">
        <fieldset class="mat-field mat-fieldset">
            <legend class="mat-legend">@L["Theme"]</legend>
            <div class="mat-btn-group" role="radiogroup" aria-label="@L["Theme"]" data-live="data-theme">
                @foreach (var mode in new[] { ("system", "monitor", L["System"].Value), ("light", "sun", L["Light"].Value), ("dark", "moon", L["Dark"].Value) })
                {
                    <input type="radio" class="mat-btn-check" id="Input_Mode_@mode.Item1" name="Input.Mode" value="@mode.Item1" checked="@(Model.Input.Mode == mode.Item1)" />
                    <label class="mat-btn mat-btn--secondary" for="Input_Mode_@mode.Item1"><mm-icon name="@mode.Item2" /><span>@mode.Item3</span></label>
                }
            </div>
        </fieldset>

        <fieldset class="mat-field mat-fieldset">
            <legend class="mat-legend">@L["Accent colour"]</legend>
            <div class="mat-choices mm-accents" data-live="data-accent">
                @foreach (var accent in Model.AccentChoices)
                {
                    <label class="mat-choice">
                        <input type="radio" id="Input_Accent_@accent.Key" name="Input.Accent" value="@accent.Key" checked="@(Model.Input.Accent == accent.Key)" />
                        @if (accent.Key == "default")
                        {
                            <span class="mm-accent-dot" data-accent="@(Model.TenantColour is not null ? "custom" : Model.DefaultPreset)" data-app="@(Model.TenantColour is null && Model.DefaultPreset is null ? "matmail" : null)" aria-hidden="true"></span>
                        }
                        else
                        {
                            <span class="mm-accent-dot" data-accent="@accent.Key" aria-hidden="true"></span>
                        }
                        <span class="mat-choice__text">@accent.Label</span>
                    </label>
                }
            </div>
        </fieldset>

        <fieldset class="mat-field mat-fieldset">
            <legend class="mat-legend">@L["Text size"]</legend>
            <div class="mat-btn-group" role="radiogroup" aria-label="@L["Text size"]" data-live="data-text-size">
                @foreach (var size in new[] { ("small", L["Small"].Value), ("normal", L["Normal"].Value), ("large", L["Large"].Value) })
                {
                    <input type="radio" class="mat-btn-check" id="Input_TextSize_@size.Item1" name="Input.TextSize" value="@size.Item1" checked="@(Model.Input.TextSize == size.Item1)" />
                    <label class="mat-btn mat-btn--secondary" for="Input_TextSize_@size.Item1">@size.Item2</label>
                }
            </div>
        </fieldset>

        <fieldset class="mat-field mat-fieldset">
            <legend class="mat-legend">@L["Density"]</legend>
            <div class="mat-btn-group" role="radiogroup" aria-label="@L["Density"]" data-live="data-density">
                @foreach (var density in new[] { ("comfortable", L["Comfortable"].Value), ("compact", L["Compact"].Value) })
                {
                    <input type="radio" class="mat-btn-check" id="Input_Density_@density.Item1" name="Input.Density" value="@density.Item1" checked="@(Model.Input.Density == density.Item1)" />
                    <label class="mat-btn mat-btn--secondary" for="Input_Density_@density.Item1">@density.Item2</label>
                }
            </div>
            <span class="mat-hint">@L["Compact fits more rows on the screen."]</span>
        </fieldset>
    </mm-form-section>

    <mm-form-section title='@L["Language and time"]' icon="globe">
        <mm-field asp-for="Input.Culture" kind="select" label='@L["Language"]' asp-items="Model.Cultures" />
        <mm-picker asp-for="Input.TimeZone" asp-items="Model.TimeZones" label='@L["Time zone"]' placeholder='@L["Default (server for lists and logs, this device in the mail client)"]'
                   help='@L["Dates and times are shown in this time zone."]' />
    </mm-form-section>

    <mm-form-section title='@L["Mail"]' icon="mail">
        <fieldset class="mat-field mat-fieldset">
            <legend class="mat-legend">@L["Reading pane"]</legend>
            <div class="mat-btn-group" role="radiogroup" aria-label="@L["Reading pane"]">
                @foreach (var pane in new[] { ("off", L["Off"].Value), ("right", L["Right of the list"].Value), ("below", L["Below the list"].Value) })
                {
                    <input type="radio" class="mat-btn-check" id="Input_ReadingPane_@pane.Item1" name="Input.ReadingPane" value="@pane.Item1" checked="@(Model.Input.ReadingPane == pane.Item1)" />
                    <label class="mat-btn mat-btn--secondary" for="Input_ReadingPane_@pane.Item1">@pane.Item2</label>
                }
            </div>
            <span class="mat-hint">@L["Off: a message opens in place of the list. On small screens it always does."]</span>
        </fieldset>
        <mm-field asp-for="Input.ShowPreviews" kind="checkbox" label='@L["Show the first words of a message in the list"]' />
        <mm-field asp-for="Input.ConversationView" kind="checkbox" label='@L["Group messages into conversations"]'
                  help='@L["The list shows one row per conversation; opening it shows all its messages."]' />
    </mm-form-section>

    <mm-button-row>
        <mm-button variant="primary" type="submit" icon="save">@L["Save"]</mm-button>
    </mm-button-row>
</mm-form>
