@page "/Admin/Queue/Details"
@model MatMail.Pages.Admin.Queue.DetailsModel
@{
    ViewData["Breadcrumb"] = "Administration / Outgoing queue / Details";
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Item?.Subject) ? L["(no subject)"].Value : Model.Item!.Subject;
    ViewData["Width"] = "narrow";
}

@if (Model.Item is { } item)
{
    @* One form for all the actions of the entry (the handler is named on the button): the toolkit puts the buttons of the row in order. *@
    <mm-form>
        <input type="hidden" name="id" value="@item.Id" />

        <mm-card>
            <dl class="mat-kv">
                <dt>@L["Status"]</dt>
                <dd>
                    @switch (item.Status)
                    {
                        case OutboundStatus.Sent: <mm-badge kind="ok">@L["Sent"]</mm-badge> break;
                        case OutboundStatus.Failed: <mm-badge kind="danger">@L["Failed"]</mm-badge> break;
                        case OutboundStatus.Sending: <mm-badge kind="info">@L["Sending"]</mm-badge> break;
                        case OutboundStatus.Cancelled: <mm-badge kind="muted">@L["Cancelled"]</mm-badge> break;
                        default: <mm-badge kind="warn">@L["Waiting"]</mm-badge> break;
                    }
                </dd>
                <dt>@L["Sender"]</dt><dd>@item.EnvelopeFrom</dd>
                <dt>@L["Recipients"]</dt><dd>@string.Join(", ", item.Recipients)</dd>
                <dt>@L["Size"]</dt><dd>@Fmt.Size(item.SizeBytes)</dd>
                <dt>@L["Sent through"]</dt><dd>@(Model.AccountName ?? L["Direct delivery"].Value)</dd>
                <dt>@L["Attempts"]</dt><dd>@item.AttemptCount</dd>
                <dt>@L["Queued"]</dt><dd>@Fmt.DateTimeText(item.CreateDate)</dd>
                @if (item.Status == OutboundStatus.Pending) { <dt>@L["Next attempt"]</dt><dd>@Fmt.DateTimeText(item.NextAttemptDate)</dd> }
                @if (item.SentDate is not null) { <dt>@L["Delivered"]</dt><dd>@Fmt.DateTimeText(item.SentDate)</dd> }
                @if (!string.IsNullOrEmpty(item.LastError)) { <dt>@L["Last error"]</dt><dd class="mat-mono mm-pre-wrap">@item.LastError</dd> }
            </dl>
        </mm-card>

        <mm-button-row>
            @if (item.Status is OutboundStatus.Failed or OutboundStatus.Pending or OutboundStatus.Cancelled)
            {
                <mm-button variant="primary" type="submit" handler="Retry" icon="refresh">@L["Try again now"]</mm-button>
            }
            @if (item.Status == OutboundStatus.Pending)
            {
                <mm-button variant="secondary" type="submit" handler="Cancel" icon="x">@L["Cancel sending"]</mm-button>
            }
            <mm-button variant="secondary" href='@($"/Admin/Queue/Details?id={item.Id}&handler=Download")' icon="download">@L["Download message (.eml)"]</mm-button>
            <mm-button variant="secondary" href="/Admin/Queue" icon="back">@L["Back"]</mm-button>
            <mm-button-spacer />
            <mm-button variant="danger" type="submit" handler="Delete" icon="trash" confirm='@L["Remove this entry from the queue?"]'>@L["Delete"]</mm-button>
        </mm-button-row>
    </mm-form>
}
