@page "/Admin/Backup/Plans"
@model MatMail.Pages.Admin.Backup.PlansModel
@{
    ViewData["Breadcrumb"] = "Administration / Backups / Schedules";
    ViewData["Title"] = L["Backups"].Value;
    ViewData["Description"] = L["A schedule says when a backup is made, where it goes, and how many are kept."].Value;
}

<partial name="_BackupTabs" model='"plans"' />

<mm-list>
<mm-toolbar count="Model.Paged.Total">
    <mm-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Search schedules or targets…"]' />
    <mm-toolbar-select name="Status" label='@L["Status"]' value="@Model.Status">
        <option value="">@L["All"]</option>
        <option value="enabled">@L["Enabled"]</option>
        <option value="disabled">@L["Disabled"]</option>
        <option value="failed">@L["Last backup failed"]</option>
    </mm-toolbar-select>
    <mm-toolbar-select name="Sort" label='@L["Sort"]' value="@Model.Sort">
        <option value="name_asc">@L["Name (A–Z)"]</option>
        <option value="name_desc">@L["Name (Z–A)"]</option>
        <option value="next_asc">@L["Next run"]</option>
    </mm-toolbar-select>
</mm-toolbar>

<mm-table item-count="Model.Paged.Rows.Count" empty-text='@L["No schedule yet. Without one, nothing is backed up."]' empty-icon="calendar">
    <thead>
        <tr>
            <th>@L["Schedule"]</th>
            <th>@L["When"]</th>
            <th class="mat-hide-sm">@L["Target"]</th>
            <th class="mat-hide-sm">@L["Keeps"]</th>
            <th>@L["Next run"]</th>
            <th>@L["Last run"]</th>
            <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var plan in Model.Paged.Rows)
        {
            <tr data-row-href="/Admin/Backup/Plan?id=@plan.Id">
                <td>
                    <div class="mat-table__name"><span><a href="/Admin/Backup/Plan?id=@plan.Id">@plan.Name</a>@if (plan.Encrypt) { <span class="mat-muted" role="img" aria-label="@L["Encrypted"]" data-tip="@L["Encrypted"]"> <mm-icon name="lock" /></span> }</span></div>
                </td>
                <td>@Model.Schedule(plan)</td>
                <td class="mat-hide-sm">@plan.Target?.Name</td>
                <td class="mat-hide-sm mat-muted">@Model.Keeps(plan)</td>
                <td class="mat-mono mat-nowrap">
                    @if (!plan.IsActive) { <mm-badge kind="muted">@L["Disabled"]</mm-badge> } else { <span>@Fmt.DateTimeText(plan.NextRunDate)</span> }
                </td>
                <td>
                    <div>
                        @if (plan.LastStatus == BackupRunStatus.Failed) { <mm-badge kind="danger">@L["Failed"]</mm-badge> }
                        else if (plan.LastStatus == BackupRunStatus.Succeeded) { <mm-badge kind="ok">@L["Succeeded"]</mm-badge> }
                        else { <span class="mat-muted">–</span> }
                        @if (plan.LastStatus is not null) { <small class="mat-muted mat-mono mat-d-block">@Fmt.Ago(plan.LastRunDate)</small> }
                    </div>
                </td>
                <td class="mat-table__cell-actions">
                    <div class="mat-table__actions">
                        <mm-button variant="ghost" href='@($"/Admin/Backup/Plan?id={plan.Id}")' icon="edit" icon-only="true" small="true">@L["Edit"]</mm-button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</mm-table>

<mm-pagination current-page="Model.Paged.PageNumber" total-pages="Model.Paged.TotalPages" total-count="Model.Paged.Total" page-size="Model.Paged.PageSize" />

<mm-list-actions>
    <mm-button variant="primary" href="/Admin/Backup/Plan" icon="plus">@L["New schedule"]</mm-button>
</mm-list-actions>
</mm-list>
