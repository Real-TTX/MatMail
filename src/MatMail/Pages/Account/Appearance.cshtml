@page "/Account/Appearance"
@model MatMail.Pages.Account.AppearanceModel
@{
    ViewData["Breadcrumb"] = "Account / Appearance";
    ViewData["Title"] = L["My account"].Value;
    var accentColors = new Dictionary<string, string>
    {
        ["blue"] = "#1a73e8", ["green"] = "#188038", ["violet"] = "#7c3aed", ["teal"] = "#0f766e",
        ["amber"] = "#b45309", ["rose"] = "#be123c", ["graphite"] = "#475569",
    };
}

<partial name="_AccountTabs" model='"appearance"' />

<mm-form>
    <mm-form-section title='@L["Appearance"]' icon="sliders">
        <div class="form-row">
            <label>@L["Theme"]</label>
            <div class="segmented segmented--wide" data-appearance-mode>
                @foreach (var mode in new[] { ("system", "monitor", L["System"].Value), ("light", "sun", L["Light"].Value), ("dark", "moon", L["Dark"].Value) })
                {
                    <label class="segmented__item @(Model.Input.Mode == mode.Item1 ? "is-active" : "")">
                        <input type="radio" class="sr-only" name="Input.Mode" value="@mode.Item1" checked="@(Model.Input.Mode == mode.Item1)" />
                        <mm-icon name="@mode.Item2" /><span>@mode.Item3</span>
                    </label>
                }
            </div>
        </div>

        <div class="form-row">
            <label>@L["Accent colour"]</label>
            <div class="swatches" data-appearance-accent>
                @foreach (var accent in accentColors)
                {
                    <label class="swatch @(Model.Input.Accent == accent.Key ? "is-active" : "")" title="@accent.Key">
                        <input type="radio" class="sr-only" name="Input.Accent" value="@accent.Key" checked="@(Model.Input.Accent == accent.Key)" />
                        <span class="swatch__dot" style="background:@accent.Value"></span>
                    </label>
                }
            </div>
        </div>

        <div class="form-row">
            <label>@L["Text size"]</label>
            <div class="segmented segmented--wide" data-appearance-attribute="data-text-size">
                @foreach (var size in new[] { ("small", L["Small"].Value), ("normal", L["Normal"].Value), ("large", L["Large"].Value) })
                {
                    <label class="segmented__item @(Model.Input.TextSize == size.Item1 ? "is-active" : "")">
                        <input type="radio" class="sr-only" name="Input.TextSize" value="@size.Item1" checked="@(Model.Input.TextSize == size.Item1)" />
                        <span>@size.Item2</span>
                    </label>
                }
            </div>
        </div>

        <div class="form-row">
            <label>@L["Density"]</label>
            <div class="segmented segmented--wide" data-appearance-attribute="data-density">
                @foreach (var density in new[] { ("comfortable", L["Comfortable"].Value), ("compact", L["Compact"].Value) })
                {
                    <label class="segmented__item @(Model.Input.Density == density.Item1 ? "is-active" : "")">
                        <input type="radio" class="sr-only" name="Input.Density" value="@density.Item1" checked="@(Model.Input.Density == density.Item1)" />
                        <span>@density.Item2</span>
                    </label>
                }
            </div>
            <p class="form-help">@L["Compact fits more rows on the screen."]</p>
        </div>

        <mm-field asp-for="Input.Culture" kind="select" label='@L["Language"]' asp-items="Model.Cultures" />
        <mm-picker asp-for="Input.TimeZone" asp-items="Model.TimeZones" label='@L["Time zone"]' placeholder='@L["Default (server for lists and logs, this device in the mail client)"]'
                   help='@L["Dates and times are shown in this time zone."]' />
        <mm-field asp-for="Input.ShowPreviews" kind="checkbox" label='@L["Show the first words of a message in the list"]' />
    </mm-form-section>

    <mm-button-row>
        <mm-button variant="primary" type="submit" icon="save">@L["Save"]</mm-button>
    </mm-button-row>
</mm-form>

@section Scripts {
    <script>
        // Live preview of the choice before it is saved.
        (function () {
            var root = document.documentElement;
            function dark(mode) { return mode === "dark" || (mode === "system" && matchMedia("(prefers-color-scheme: dark)").matches); }
            document.querySelectorAll("[data-appearance-mode] input").forEach(function (input) {
                input.addEventListener("change", function () {
                    document.querySelectorAll("[data-appearance-mode] .segmented__item").forEach(function (i) { i.classList.toggle("is-active", i.contains(input)); });
                    root.setAttribute("data-theme-mode", input.value);
                    root.setAttribute("data-mode", dark(input.value) ? "dark" : "light");
                });
            });
            // Text size and density: the attribute of <html> that the style sheet reacts to.
            document.querySelectorAll("[data-appearance-attribute]").forEach(function (group) {
                var attribute = group.getAttribute("data-appearance-attribute");
                group.querySelectorAll("input").forEach(function (input) {
                    input.addEventListener("change", function () {
                        group.querySelectorAll(".segmented__item").forEach(function (i) { i.classList.toggle("is-active", i.contains(input)); });
                        root.setAttribute(attribute, input.value);
                    });
                });
            });
            document.querySelectorAll("[data-appearance-accent] input").forEach(function (input) {
                input.addEventListener("change", function () {
                    document.querySelectorAll("[data-appearance-accent] .swatch").forEach(function (i) { i.classList.toggle("is-active", i.contains(input)); });
                    root.setAttribute("data-accent", input.value);
                });
            });
        })();
    </script>
}
