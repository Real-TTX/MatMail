@page "/Mail"
@model MatMail.Pages.Mail.IndexModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Area"] = "mail";
    ViewData["Title"] = L["Mail"].Value;
    var token = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
}

@section Head {
    <meta name="csrf-token" content="@token" />
}

@section Sidebar {
    <div class="mail-sidebar">
        <button type="button" class="btn-compose" id="mail-compose-button">
            <mm-icon name="edit" /><span>@L["Compose"]</span>
        </button>
        <nav class="mail-folders" id="mail-folders" aria-label="@L["Folders"]"></nav>
    </div>
}

@section HeaderCenter {
    <form class="mail-search" id="mail-search" role="search" autocomplete="off">
        <mm-icon name="search" class="mail-search__icon" />
        <input type="search" id="mail-search-input" class="mail-search__input" placeholder="@L["Search mail"]" aria-label="@L["Search mail"]" />
        <button type="button" class="icon-btn mail-search__clear" id="mail-search-clear" aria-label="@L["Clear search"]" hidden><mm-icon name="x" /></button>
        <button type="button" class="icon-btn mail-search__options" id="mail-search-options" title="@L["Search options"]" aria-label="@L["Search options"]" aria-haspopup="dialog" aria-expanded="false"><mm-icon name="sliders" /></button>
    </form>
}

<script type="application/json" id="mail-i18n">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Texts))</script>
<div class="mail-app" id="mail-app">
    <div class="mail-offline" id="mail-offline" role="status" hidden></div>
    <section class="mail-pane mail-pane--list" id="mail-list-pane">
        <div class="mail-toolbar" id="mail-list-toolbar"></div>
        @* "All 50 on this page are selected. Select all 1,234 that match": offered when the selection fills the page and there are more hits. *@
        <div class="mail-selectbar" id="mail-selectbar" hidden></div>
        <div class="mail-notice" id="mail-notice" hidden></div>
        <div class="mail-list" id="mail-list" role="list"></div>
        <div class="mail-empty" id="mail-empty" hidden>
            <mm-icon name="inbox" class="mail-empty__icon" />
            <p id="mail-empty-text">@L["Nothing here."]</p>
        </div>
    </section>

    <section class="mail-pane mail-pane--reader" id="mail-reader-pane" hidden>
        <div class="mail-toolbar" id="mail-reader-toolbar"></div>
        <div class="mail-reader" id="mail-reader"></div>
    </section>

    <div class="mail-loading" id="mail-loading" hidden><span class="spinner"></span></div>

    @* Where the folders are a drawer (up to 960 px): the round button over the list, bottom right; above that the one in the folder column does the job. *@
    <button type="button" class="fab-compose" id="mail-compose-fab" title="@L["Compose"]" aria-label="@L["Compose"]"><mm-icon name="edit" /></button>
</div>

<div class="compose-dock" id="compose-dock" aria-live="polite"></div>
<div class="mail-toasts" id="mail-toasts" role="status" aria-live="polite"></div>
<div class="menu-layer" id="mail-menu-layer" hidden></div>
@* The advanced search lives out here, not in the header: its blurred background would make a full-screen sheet as small as the header. *@
<div class="search-layer" id="mail-search-layer" hidden></div>

@section Scripts {
    <script src="~/js/mail-core.js" asp-append-version="true"></script>
    <script src="~/js/mail-outbox.js" asp-append-version="true"></script>
    <script src="~/js/mail-compose.js" asp-append-version="true"></script>
    <script src="~/js/mail-viewer.js" asp-append-version="true"></script>
    <script src="~/js/mail-search.js" asp-append-version="true"></script>
    <script src="~/js/mail-ui.js" asp-append-version="true"></script>
}
