@page "/Admin/Queue"
@model MatMail.Pages.Admin.Queue.IndexModel
@{
    ViewData["Breadcrumb"] = "Administration / Outgoing queue";
    ViewData["Description"] = L["Messages for recipients at other servers wait here until they are delivered. Failed ones are retried automatically."].Value;
}

<mm-list>
<mm-toolbar count="Model.Paged.Total">
    <mm-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Search subject, sender, recipient or error…"]' />
    <mm-toolbar-select name="Status" label='@L["Status"]' value="@Model.Status">
        <option value="">@L["All"]</option>
        <option value="Pending">@L["Waiting"]</option>
        <option value="Sending">@L["Sending"]</option>
        <option value="Sent">@L["Sent"]</option>
        <option value="Failed">@L["Failed"]</option>
        <option value="Cancelled">@L["Cancelled"]</option>
    </mm-toolbar-select>
    <mm-toolbar-select name="Sort" label='@L["Sort"]' value="@Model.Sort">
        <option value="created_desc">@L["Newest first"]</option>
        <option value="created_asc">@L["Oldest first"]</option>
        <option value="next_asc">@L["Next attempt"]</option>
    </mm-toolbar-select>
</mm-toolbar>

<mm-table item-count="Model.Paged.Rows.Count" empty-text='@L["The queue is empty."]' empty-icon="send">
    <thead>
        <tr>
            <th>@L["Message"]</th>
            <th class="mat-hide-sm">@L["Recipients"]</th>
            <th>@L["Status"]</th>
            <th class="mat-hide-sm mat-num">@L["Attempts"]</th>
            <th class="mat-hide-sm">@L["When"]</th>
            <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Paged.Rows)
        {
            <tr data-row-href="/Admin/Queue/Details?id=@item.Id">
                <td>
                    <div class="mat-table__name"><span><a href="/Admin/Queue/Details?id=@item.Id">@(string.IsNullOrWhiteSpace(item.Subject) ? L["(no subject)"].Value : item.Subject)</a><small>@item.EnvelopeFrom · @Fmt.Size(item.SizeBytes)</small></span></div>
                </td>
                <td class="mat-hide-sm">@string.Join(", ", item.Recipients.Take(2))@(item.Recipients.Length > 2 ? $" +{item.Recipients.Length - 2}" : "")</td>
                <td>
                    <div>
                        @switch (item.Status)
                        {
                            case OutboundStatus.Sent: <mm-badge kind="ok">@L["Sent"]</mm-badge> break;
                            case OutboundStatus.Failed: <mm-badge kind="danger">@L["Failed"]</mm-badge> break;
                            case OutboundStatus.Sending: <mm-badge kind="info">@L["Sending"]</mm-badge> break;
                            case OutboundStatus.Cancelled: <mm-badge kind="muted">@L["Cancelled"]</mm-badge> break;
                            default: <mm-badge kind="warn">@L["Waiting"]</mm-badge> break;
                        }
                        @if (!string.IsNullOrEmpty(item.LastError) && item.Status != OutboundStatus.Sent) { <small class="mat-muted mat-d-block mat-text-break">@item.LastError</small> }
                    </div>
                </td>
                <td class="mat-hide-sm mat-num">@item.AttemptCount</td>
                <td class="mat-hide-sm mat-mono mat-nowrap">@(item.Status == OutboundStatus.Sent ? Fmt.Ago(item.SentDate) : item.Status == OutboundStatus.Pending ? Fmt.DateTimeText(item.NextAttemptDate) : Fmt.Ago(item.UpdateDate))</td>
                <td class="mat-table__cell-actions">
                    <div class="mat-table__actions">
                        @if (item.Status is OutboundStatus.Failed or OutboundStatus.Pending or OutboundStatus.Cancelled)
                        {
                            <form method="post" asp-page-handler="Retry" data-no-busy>
                                <input type="hidden" name="id" value="@item.Id" />
                                <mm-button variant="ghost" type="submit" icon="refresh" icon-only="true" small="true">@L["Try again now"]</mm-button>
                            </form>
                        }
                        <mm-button variant="ghost" href='@($"/Admin/Queue/Details?id={item.Id}")' icon="eye" icon-only="true" small="true">@L["Details"]</mm-button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</mm-table>

<mm-pagination current-page="Model.Paged.PageNumber" total-pages="Model.Paged.TotalPages" total-count="Model.Paged.Total" page-size="Model.Paged.PageSize" />

<mm-list-actions>
    @* The buttons belong to hidden forms (attribute form): the toolkit puts the buttons of a row of actions in order, which a form around each one would prevent. *@
    <form method="post" asp-page-handler="RetryAllFailed" id="queue-retry-failed" hidden></form>
    <form method="post" asp-page-handler="ClearFinished" id="queue-clear-finished" hidden></form>
    <mm-button variant="secondary" type="submit" form="queue-retry-failed" icon="refresh">@L["Try all failed again"]</mm-button>
    <mm-button-spacer />
    <mm-button variant="danger" type="submit" form="queue-clear-finished" icon="trash" confirm='@L["Remove all finished entries (sent, cancelled) from the list?"]'>@L["Clear finished"]</mm-button>
</mm-list-actions>
</mm-list>
