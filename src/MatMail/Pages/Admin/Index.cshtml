@page "/Admin"
@model MatMail.Pages.Admin.IndexModel
@{
    ViewData["Breadcrumb"] = "Administration";
    ViewData["Title"] = L["Dashboard"].Value;
    ViewData["Description"] = string.Format(L["Overview of tenant “{0}”."].Value, Model.TenantName);

    // One number that somebody acts on, as a card that leads to its list.
    Microsoft.AspNetCore.Html.IHtmlContent Stat(string href, long value, string label)
        => new Microsoft.AspNetCore.Html.HtmlString($"<a class=\"mat-card mat-card--link mat-col-6 mat-col-md-4\" href=\"{href}\"><div class=\"mat-card__body mat-stat\"><span class=\"mat-stat__label\">{System.Net.WebUtility.HtmlEncode(label)}</span><span class=\"mat-stat__value\">{value}</span></div></a>");
}

<div class="mat-cols">
    @if (Model.Can(Permissions.UsersManage)) { @Stat("/Admin/Users", Model.UserCount, L["Users"].Value) }
    @if (Model.Can(Permissions.MailboxesManage)) { @Stat("/Admin/Mailboxes", Model.MailboxCount, L["Mailboxes"].Value) }
    @if (Model.Can(Permissions.DomainsManage)) { @Stat("/Admin/Domains", Model.DomainCount, L["Domains"].Value) }
    @if (Model.Can(Permissions.AccountsManage)) { @Stat("/Admin/Accounts", Model.AccountCount, L["Connected accounts"].Value) }
    @if (Model.Can(Permissions.QueueManage)) { @Stat("/Admin/Queue", Model.QueuedCount, L["Waiting to be sent"].Value) }
    @if (Model.Can(Permissions.UnassignedManage)) { @Stat("/Admin/Unassigned", Model.UnassignedCount, L["Unassigned messages"].Value) }
</div>

<div class="mat-cols">
    @if (Model.AccountProblems.Count > 0)
    {
        <mm-card class="mat-col-12 mat-col-md-6" title='@L["Connected accounts with problems"]' icon="alert">
            <ul class="mat-listgroup mat-listgroup--flush">
                @foreach (var account in Model.AccountProblems)
                {
                    <li><a class="mat-listgroup__item" href="/Admin/Accounts/Edit?id=@account.Id"><span class="mat-listgroup__text"><strong>@account.Name</strong><small>@account.LastSyncMessage</small></span></a></li>
                }
            </ul>
        </mm-card>
    }

    @if (Model.DirectoryProblems.Count > 0)
    {
        <mm-card class="mat-col-12 mat-col-md-6" title='@L["Directories with problems"]' icon="alert">
            <ul class="mat-listgroup mat-listgroup--flush">
                @foreach (var directory in Model.DirectoryProblems)
                {
                    <li><a class="mat-listgroup__item" href="/Admin/Directories/Edit?id=@directory.Id"><span class="mat-listgroup__text"><strong>@directory.Name</strong><small>@(directory.LastSyncDate is not null ? directory.LastSyncMessage : directory.LastCheckMessage)</small></span></a></li>
                }
            </ul>
        </mm-card>
    }

    @if (Model.Can(Permissions.LogsView))
    {
        <mm-card class="mat-col-12 mat-col-md-6" title='@L["Recent activity"]' icon="activity">
            @if (Model.RecentLogs.Count == 0)
            {
                <p class="mat-muted">@L["Nothing happened yet."]</p>
            }
            else
            {
                <ol class="mat-timeline">
                    @foreach (var log in Model.RecentLogs)
                    {
                        <li class="@(log.Level == ActivityLevel.Error ? "mat-timeline__error" : log.Level == ActivityLevel.Warning ? "mat-timeline__warn" : "")">
                            <span class="mat-timeline__time">@Fmt.Ago(log.CreateDate)</span>
                            <strong>@log.Category</strong> @log.Message
                        </li>
                    }
                </ol>
            }
            <mm-list-actions><mm-button variant="secondary" href="/Admin/Logs" icon="activity">@L["Open the activity log"]</mm-button></mm-list-actions>
        </mm-card>
    }
</div>
