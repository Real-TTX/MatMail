@page "/Admin/Roles"
@model MatMail.Pages.Admin.Roles.IndexModel
@{
    ViewData["Breadcrumb"] = "Administration / Roles";
    ViewData["Title"] = L["Roles"].Value;
    ViewData["Description"] = L["A role is a set of permissions. Users can hold several roles."].Value;
}

<mm-list>
    <mm-toolbar count="Model.Paged.Total">
        <mm-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Search roles…"]' />
        <mm-toolbar-select name="Sort" label='@L["Sort"]' value="@Model.Sort">
            <option value="name_asc">@L["Name (A–Z)"]</option>
            <option value="name_desc">@L["Name (Z–A)"]</option>
            <option value="users_desc">@L["Most users"]</option>
        </mm-toolbar-select>
    </mm-toolbar>

    <mm-table item-count="Model.Paged.Rows.Count" empty-text='@L["No roles match."]' empty-icon="shield">
        <thead>
            <tr>
                <th>@L["Role"]</th>
                <th class="mat-num">@L["Permissions"]</th>
                <th class="mat-num mat-hide-sm">@L["Users"]</th>
                <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in Model.Paged.Rows)
            {
                <tr data-row-href="/Admin/Roles/Edit?id=@role.Id">
                    <td>
                        <div class="mat-table__name"><span><a href="/Admin/Roles/Edit?id=@role.Id">@role.Name</a> @if (role.IsBuiltIn) { <mm-badge kind="info">@L["Built-in"]</mm-badge> }@if (!string.IsNullOrEmpty(role.Description)) { <small>@role.Description</small> }</span></div>
                    </td>
                    <td class="mat-num">@role.PermissionCount / @Permissions.All.Count</td>
                    <td class="mat-num mat-hide-sm">@role.Users</td>
                    <td class="mat-table__cell-actions">
                        <div class="mat-table__actions">
                            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Admin/Roles/Edit?id=@role.Id" data-tip="@L["Edit"]" aria-label="@L["Edit"]"><mm-icon name="edit" /></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </mm-table>

    <mm-pagination current-page="Model.Paged.PageNumber" total-pages="Model.Paged.TotalPages" total-count="Model.Paged.Total" page-size="Model.Paged.PageSize" />

    <mm-list-actions>
        <mm-button variant="primary" href="/Admin/Roles/Edit" icon="plus">@L["New role"]</mm-button>
    </mm-list-actions>
</mm-list>
