@page "/Admin/Signatures"
@model MatMail.Pages.Admin.Signatures.IndexModel
@{
    ViewData["Breadcrumb"] = "Administration / Signatures";
    ViewData["Description"] = L["Signatures are offered when writing a message. A footer is added by the server to every outgoing message, whatever program sent it."].Value;
}

<mm-toolbar count="Model.Paged.Total">
    <mm-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Search signatures…"]' />
    <mm-toolbar-select name="Kind" label='@L["Type"]' value="@Model.Kind">
        <option value="">@L["All"]</option>
        <option value="Signature">@L["Signature"]</option>
        <option value="Footer">@L["Footer"]</option>
    </mm-toolbar-select>
    <mm-toolbar-select name="Scope" label='@L["Applies to"]' value="@Model.Scope">
        <option value="">@L["Everything"]</option>
        <option value="Tenant">@L["The whole tenant"]</option>
        <option value="Mailbox">@L["One mailbox"]</option>
        <option value="User">@L["One user"]</option>
    </mm-toolbar-select>
    <mm-toolbar-select name="Sort" label='@L["Sort"]' value="@Model.Sort">
        <option value="name_asc">@L["Name (A–Z)"]</option>
        <option value="name_desc">@L["Name (Z–A)"]</option>
        <option value="created_desc">@L["Newest first"]</option>
    </mm-toolbar-select>
</mm-toolbar>

<mm-table item-count="Model.Paged.Rows.Count" empty-text='@L["No signatures yet."]' empty-icon="pen-line">
    <thead>
        <tr>
            <th>@L["Name"]</th>
            <th>@L["Type"]</th>
            <th class="hide-sm">@L["Applies to"]</th>
            <th>@L["Status"]</th>
            <th class="is-actions"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Paged.Rows)
        {
            <tr data-row-href="/Admin/Signatures/Edit?id=@item.Id" tabindex="0">
                <td class="cell-title">@item.Name</td>
                <td>@if (item.Kind == SignatureKind.Footer) { <mm-badge kind="warn" icon="lock">@L["Footer"]</mm-badge> } else { <mm-badge kind="info">@L["Signature"]</mm-badge> }</td>
                <td class="hide-sm">@Model.Target(item)</td>
                <td>
                    @if (!item.IsActive) { <mm-badge kind="muted">@L["Inactive"]</mm-badge> }
                    else
                    {
                        <mm-badge kind="ok">@L["Active"]</mm-badge>
                        @if (item.IsDefault) { <mm-badge kind="info" icon="star">@L["Default"]</mm-badge> }
                    }
                </td>
                <td class="is-actions"><span class="icon-actions"><a class="icon-btn" href="/Admin/Signatures/Edit?id=@item.Id" title="@L["Edit"]" aria-label="@L["Edit"]"><mm-icon name="edit" /></a></span></td>
            </tr>
        }
    </tbody>
</mm-table>

<mm-pagination current-page="Model.Paged.PageNumber" total-pages="Model.Paged.TotalPages" total-count="Model.Paged.Total" page-size="Model.Paged.PageSize" />

<mm-list-actions>
    <mm-button variant="primary" href="/Admin/Signatures/Edit" icon="plus">@L["New signature"]</mm-button>
</mm-list-actions>
