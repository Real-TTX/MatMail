@page "/Account/AccessDenied"
@model MatMail.Pages.Account.AccessDeniedModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = L["No access"].Value;
}

<div class="mat-auth__card">
    <partial name="_AuthBrand" />
    <div class="mat-stack mat-stack--sm">
        <h1>@L["No access"]</h1>
        <p class="mat-muted">@L["You are not allowed to open this page."]</p>
    </div>
    <mm-button-row>
        <mm-button variant="primary" href="/" icon="home">@L["Back to start"]</mm-button>
    </mm-button-row>
</div>
