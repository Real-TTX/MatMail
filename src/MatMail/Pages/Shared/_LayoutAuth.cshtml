@inject ThemeService Themes
@inject Toolkit Toolkit
@{
    // Pages without a menu (SHELL-11): sign-in, setup, errors. A centred card on the plain page background; a page that needs room sets ShellClass to "mm-auth-stack--wide".
    var theme = Themes.Resolve();
    Brand brand = ViewData["Brand"] as Brand ?? Brand.None;
    string productName = brand.Name ?? "MatMail";
    var title = ViewData["Title"] as string ?? "MatMail";
    var culture = global::System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    string? preset = theme.Accent == "default" ? null : theme.Accent;
    string? accent = theme.UserHasAccent ? preset : brand.AccentColor is not null ? "custom" : preset;
    string? brandColor = accent == "custom" ? brand.AccentColor : null;
    var head = new HeadModel(title + " · " + productName, productName, brandColor);
}
<!DOCTYPE html>
<html lang="@culture" data-app="matmail" data-theme="@(theme.UserHasMode || theme.Mode != "system" ? theme.Mode : null)" data-accent="@accent" @Toolkit.LanguageAttributes(L)>
<head>
    <partial name="_Head" model="head" />
</head>
<body>
    <a class="mat-skip" href="#main">@L["Skip to the content"]</a>
    @Html.Raw(Toolkit.Sprite)
    <main class="mat-auth" id="main">
        <div class="mm-auth-stack @(ViewData["ShellClass"] as string)">
            <partial name="_Notice" />
            @RenderBody()

            <form class="mm-lang-switch" method="post" action="/Account/Language" role="group" aria-label="@L["Language"]">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <div class="mat-seg">
                    <button type="submit" name="culture" value="de-DE" class="mat-seg__btn" aria-pressed="@(culture == "de" ? "true" : "false")">DE</button>
                    <button type="submit" name="culture" value="en-US" class="mat-seg__btn" aria-pressed="@(culture == "en" ? "true" : "false")">EN</button>
                </div>
            </form>
            <div class="mm-auth-version">MatMail @AppInfo.Version</div>
        </div>
    </main>

    <script src="~/matui/matui.js" asp-append-version="true"></script>
    <script src="~/js/matmail.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true" data-worker="/sw.js?v=@AppInfo.Version"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
