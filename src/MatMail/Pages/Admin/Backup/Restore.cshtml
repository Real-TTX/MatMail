@page "/Admin/Backup/Restore"
@model MatMail.Pages.Admin.Backup.RestoreModel
@{
    ViewData["Breadcrumb"] = "Administration / Backups / Restore";
    ViewData["Title"] = L["Backups"].Value;
    ViewData["Description"] = L["Put a backup in place of what is here: the database and the files of the data volume. Backups of earlier versions can be restored too; they are brought up to this version."].Value;
}

<partial name="_BackupTabs" model='"restore"' />

<script type="application/json" id="backup-i18n">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Texts))</script>

<mm-alert kind="warn">@L["A restore replaces the current data completely. Mail that arrived after the backup was made is not in it. Before anything is replaced the current state is saved, so that a restore can be undone."]</mm-alert>

@* Which target to look into: the list follows as soon as one is chosen (backup.js); without a script the button does it. *@
<form method="get" class="mat-form mat-form--inline">
    <div class="mat-field mat-field--auto">
        <label class="mat-label" for="restore-target">@L["Backups in"]</label>
        <select id="restore-target" name="Target" class="mat-select" data-autosubmit>
            <option value="">@L["Choose a target …"]</option>
            @foreach (var item in Model.TargetItems) { <option value="@item.Value" selected="@(Model.Target?.ToString() == item.Value)">@item.Text</option> }
        </select>
    </div>
    <noscript>
        <div class="mat-field mat-field--auto"><mm-button variant="secondary" type="submit" icon="search">@L["Show"]</mm-button></div>
    </noscript>
</form>

@if (Model.TargetError is not null)
{
    <mm-alert kind="danger">@Model.TargetError</mm-alert>
}

@if (Model.Target is not null && Model.TargetError is null)
{
    <mm-table item-count="Model.Files.Count" empty-text='@L["There is no backup in this target."]' empty-icon="archive">
        <thead>
            <tr>
                <th>@L["Made"]</th>
                <th>@L["By"]</th>
                <th class="mat-hide-sm">@L["Version"]</th>
                <th class="mat-hide-sm mat-num">@L["Size"]</th>
                <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var file in Model.Files)
            {
                <tr>
                    <td class="mat-nowrap">
                        <span><span class="mat-mono">@Fmt.DateTimeText(file.CreatedUtc)</span>@if (file.Encrypted) { <span class="mat-muted" role="img" aria-label="@L["Encrypted"]" data-tip="@L["Encrypted"]"> <mm-icon name="lock" /></span> }</span>
                    </td>
                    <td>@file.MadeBy</td>
                    <td class="mat-hide-sm mat-mono">@file.Version</td>
                    <td class="mat-hide-sm mat-num mat-nowrap">@Fmt.Size(file.Bytes)</td>
                    <td class="mat-table__cell-actions">
                        <div class="mat-table__actions">
                            <mm-button variant="ghost" href='@($"/Admin/Backup/Restore?handler=File&target={Model.Target}&file={Uri.EscapeDataString(file.Name)}")' icon="download" icon-only="true" small="true">@L["Download"]</mm-button>
                            <mm-button variant="ghost" href='@($"/Admin/Backup/RestoreConfirm?target={Model.Target}&file={Uri.EscapeDataString(file.Name)}")' icon="restore" icon-only="true" small="true">@L["Restore this backup"]</mm-button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </mm-table>
    @if (Model.TotalFiles > Model.Files.Count)
    {
        <p class="mat-muted">@string.Format(L["The newest {0} of {1} backups are shown."].Value, Model.Files.Count, Model.TotalFiles)</p>
    }
}

@* A backup from the computer of the administrator: the file is sent as it is (backup.js), then the confirmation page shows what it holds. *@
<mm-card id="backup-upload" title='@L["Restore from a file"]' icon="upload" data-url="/Admin/Backup/Restore?handler=Upload" data-next="/Admin/Backup/RestoreConfirm">
    <p class="mat-muted">@L["A backup you have on your computer, from this or another MatMail. The file is sent to the server first; then you see what it holds before anything is replaced."]</p>
    <label class="mat-dropzone" for="backup-file"><mm-icon name="upload" /><strong>@L["Drop the backup file here or click to choose it"]</strong><span class="mat-muted">.zip, .mmbak</span><input type="file" id="backup-file" accept=".zip,.mmbak" /><span class="mat-dropzone__files"></span></label>
    <div class="mat-meter" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-label="@L["Progress"]" hidden><div class="mat-meter__fill"></div></div>
    <p class="mat-muted" data-upload-text></p>
    <div class="mat-row">
        <mm-button variant="primary" type="button" icon="upload" data-upload="true">@L["Upload"]</mm-button>
    </div>
    @Html.AntiForgeryToken()
</mm-card>

@section Scripts {
    <script src="~/js/backup.js" asp-append-version="true"></script>
}
