@page "/Account/Password"
@model MatMail.Pages.Account.PasswordModel
@{
    ViewData["Breadcrumb"] = "Account / Password";
    ViewData["Title"] = L["Password"].Value;
    ViewData["Width"] = "narrow";
}

@if (MustChange)
{
    <mm-alert kind="warn">@L["You have to choose a new password before you continue."]</mm-alert>
}

@if (Model.DirectoryName is not null)
{
    <mm-alert kind="info" icon="server">@string.Format(L["You sign in through the directory “{0}”. Your password is the one of that directory: change it there, in the way your organisation does it. For mail programs you can still make app passwords under Security."].Value, Model.DirectoryName)</mm-alert>
}
else
{
    <mm-form>
        <mm-form-section title='@L["Change password"]' icon="key" description='@L["After the change your other sessions are signed out."]'>
            <mm-field asp-for="Input.Current" kind="password" label='@L["Current password"]' autocomplete="current-password" />
            <div class="mat-form__grid">
                <mm-field asp-for="Input.New" kind="password" label='@L["New password"]' autocomplete="new-password" reveal="true" help='@L["At least 10 characters."]' />
                <mm-field asp-for="Input.Repeat" kind="password" label='@L["Repeat new password"]' autocomplete="new-password" />
            </div>
        </mm-form-section>

        <mm-button-row>
            <mm-button variant="primary" type="submit" icon="save">@L["Change password"]</mm-button>
        </mm-button-row>
    </mm-form>
}

@functions {
    private bool MustChange => User.HasClaim(AppClaims.MustChangePassword, "1");
}
