@page "/Admin/Backup/Plan"
@model MatMail.Pages.Admin.Backup.PlanModel
@{
    ViewData["Breadcrumb"] = Model.IsEdit ? "Administration / Backups / Edit schedule" : "Administration / Backups / New schedule";
    ViewData["Title"] = Model.IsEdit ? Model.Input.Name : L["New schedule"].Value;
    ViewData["Width"] = "narrow";
}

@if (Model.TargetItems.Count == 0)
{
    <mm-alert kind="warn">@L["There is no target yet. A backup needs a place to go to."] <a href="/Admin/Backup/Target">@L["Add a target"]</a></mm-alert>
}

<mm-form>
    <input type="hidden" asp-for="Id" />

    @if (Model.IsEdit && Model.Plan is { } plan)
    {
        <mm-alert kind='@(plan.LastStatus == BackupRunStatus.Failed ? "danger" : "info")' icon='@(plan.LastStatus == BackupRunStatus.Failed ? "alert" : "clock")'>
            <b>@L["Last run"]:</b> @(plan.LastRunDate is null ? L["Never"].Value : Fmt.DateTimeText(plan.LastRunDate))
            @if (plan.IsActive && plan.NextRunDate is not null) { <span class="mat-muted"> · @L["next"]: @Fmt.DateTimeText(plan.NextRunDate)</span> }
        </mm-alert>
    }

    <mm-form-section title='@L["Schedule"]' icon="calendar" columns="2">
        <mm-field asp-for="Input.Name" label='@L["Name"]' placeholder='@L["e.g. Every night to the NAS"]' autofocus="autofocus" />
        <mm-picker asp-for="Input.TargetId" asp-items="Model.TargetItems" label='@L["Target"]' placeholder='@L["Choose a target"]' />
        <mm-field asp-for="Input.Frequency" kind="select" label='@L["How often"]' asp-items="Model.FrequencyItems" />
        <mm-field asp-for="Input.EveryHours" kind="number" label='@L["Every"]' suffix='@L["hours"]' min="1" max="12"
                  show-when-field="Input.Frequency" show-when-value="Hourly" />
        <mm-field asp-for="Input.Weekday" kind="select" label='@L["On"]' asp-items="Model.WeekdayItems"
                  show-when-field="Input.Frequency" show-when-value="Weekly" />
        <mm-field asp-for="Input.DayOfMonth" kind="number" label='@L["On day"]' min="1" max="28"
                  help='@L["Up to the 28th, so that every month has the day."]'
                  show-when-field="Input.Frequency" show-when-value="Monthly" />
        <mm-field asp-for="Input.Time" kind="time" label='@L["At"]'
                  help='@L["In the time zone of this server. For a plan that runs every few hours only the minute counts."]' />
        <mm-field asp-for="Input.IsActive" kind="checkbox" label='@L["Enabled"]' full="true" />
    </mm-form-section>

    <mm-form-section title='@L["What is kept"]' icon="archive" columns="2"
                     description='@L["A backup stays as long as any of these rules keeps it. Only the backups of this schedule are ever removed."]'>
        <mm-field asp-for="Input.KeepLast" kind="number" label='@L["The newest"]' suffix='@L["copies"]' min="1" />
        <mm-field asp-for="Input.KeepDaily" kind="number" label='@L["One per day for"]' suffix='@L["days"]' min="0" />
        <mm-field asp-for="Input.KeepWeekly" kind="number" label='@L["One per week for"]' suffix='@L["weeks"]' min="0" />
        <mm-field asp-for="Input.KeepMonthly" kind="number" label='@L["One per month for"]' suffix='@L["months"]' min="0" />
    </mm-form-section>

    <mm-form-section title='@L["Protection"]' icon="lock" columns="2">
        <mm-field asp-for="Input.Encrypt" kind="checkbox" label='@L["Encrypt the backups with a passphrase"]' full="true"
                  help='@L["A backup holds everything: all mail, all passwords of the connected accounts, the keys. Encrypt it when it leaves this server."]' />
        <mm-field asp-for="Input.Passphrase" kind="password" label='@L["Passphrase"]' autocomplete="new-password" reveal="true"
                  help='@(Model.HasStoredPassphrase ? L["Leave empty to keep the passphrase. It is stored encrypted on this server."].Value : string.Format(L["At least {0} characters. It is stored encrypted on this server, so that scheduled backups can be encrypted."].Value, PlanModel.MinPassphraseLength))'
                  show-when-field="Input.Encrypt" show-when-value="true" />
        <mm-field asp-for="Input.PassphraseRepeat" kind="password" label='@L["Passphrase once more"]' autocomplete="new-password"
                  show-when-field="Input.Encrypt" show-when-value="true" />
        <mm-alert kind="warn" data-show-if="Input.Encrypt" data-show-value="true">@L["Keep the passphrase somewhere else, too. An encrypted backup cannot be opened without it, and a new server does not have it: it is only inside the backups."]</mm-alert>
        <mm-field asp-for="Input.Verify" kind="checkbox" label='@L["Read every backup back and compare it with its checksums before it counts"]' full="true" />
        <mm-field asp-for="Input.NotifyOnFailure" kind="checkbox" label='@L["Tell the administrators (a message in their mailbox) when a backup fails"]' full="true" />
    </mm-form-section>

    <mm-button-row>
        <mm-button variant="primary" type="submit" icon="save">@L["Save"]</mm-button>
        <mm-button variant="secondary" href="/Admin/Backup/Plans" icon="back">@L["Back"]</mm-button>
        @if (Model.IsEdit)
        {
            <mm-button variant="secondary" type="submit" handler="RunNow" icon="play">@L["Back up now"]</mm-button>
        }
        <mm-button-spacer />
        @if (Model.IsEdit)
        {
            <mm-button variant="danger" type="submit" handler="Delete" icon="trash"
                       confirm='@L["Delete this schedule? The backups it made are not deleted."]'>@L["Delete"]</mm-button>
        }
    </mm-button-row>
</mm-form>
