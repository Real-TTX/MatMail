@page "/Account/App"
@model MatMail.Pages.Account.AppModel
@{
    ViewData["Breadcrumb"] = "Account / App";
    ViewData["Title"] = L["App"].Value;
    ViewData["Description"] = L["MatMail can run like an app on your phone or computer: it opens in a window of its own, it still opens without a connection (what you write is kept and sent as soon as you are back online) and it can tell you when mail arrives."].Value;
    ViewData["Width"] = "narrow";
}

<script type="application/json" id="app-i18n">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Texts))</script>

<mm-card title='@L["Install the app"]' icon="download">
    <p class="mat-muted" id="app-install-text">@L["One moment …"]</p>
    <mm-button variant="primary" type="button" icon="download" id="app-install-button" class="mat-self-start" hidden="hidden">@L["Install app"]</mm-button>
</mm-card>

@if (Model.CanUseMail)
{
    <mm-card title='@L["Notifications"]' icon="bell">
        @if (!Model.PushEnabled)
        {
            <p class="mat-muted">@L["Notifications are switched off on this server."]</p>
        }
        else
        {
            <p class="mat-muted" id="push-text">@L["One moment …"]</p>
            <div class="mat-stack" id="push-controls" hidden>
                <label class="mat-switch" for="push-toggle">
                    <input type="checkbox" id="push-toggle" />
                    <span class="mat-switch__track"></span>
                    <span>@L["Tell me about new mail on this device"]</span>
                </label>
                <fieldset class="mat-field mat-fieldset" id="push-scope">
                    <legend class="mat-legend">@L["Which mailboxes"]</legend>
                    <div class="mat-checks">
                        <label class="mat-check"><input type="radio" name="push-scope" id="push-scope-own" value="own" checked /><span class="mat-check__text">@L["Only my own mailbox"]</span></label>
                        <label class="mat-check"><input type="radio" name="push-scope" id="push-scope-all" value="all" /><span class="mat-check__text">@L["Also shared and delegated mailboxes I can read"]</span></label>
                    </div>
                </fieldset>
                <mm-button variant="secondary" type="button" icon="bell" id="push-test" class="mat-self-start" hidden="hidden">@L["Send a test notification"]</mm-button>
            </div>
        }
    </mm-card>
}

@if (Model.CanUseMail && Model.PushEnabled)
{
    <mm-card title='@L["Devices that get notifications"]' icon="smartphone">
        <mm-list>
            <mm-table item-count="Model.Devices.Count" empty-text='@L["No device yet."]' empty-icon="smartphone">
                <thead>
                    <tr>
                        <th>@L["Device"]</th>
                        <th class="mat-hide-sm">@L["Mailboxes"]</th>
                        <th>@L["Last notified"]</th>
                        <th class="mat-hide-sm">@L["Added"]</th>
                        <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var device in Model.Devices)
                    {
                        <tr>
                            <td><div class="mat-table__name"><span>@device.DeviceName</span></div></td>
                            <td class="mat-hide-sm">@(device.OwnMailboxOnly ? L["Only my own mailbox"] : L["Also shared and delegated"])</td>
                            <td>@(device.LastSuccessDate is null ? "–" : Fmt.Ago(device.LastSuccessDate))</td>
                            <td class="mat-hide-sm">@Fmt.DateTimeText(device.CreateDate)</td>
                            <td class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    <form method="post" asp-page-handler="Remove" data-no-busy>
                                        <input type="hidden" name="id" value="@device.Id" />
                                        <button type="submit" class="mat-btn mat-btn--danger mat-btn--icon mat-btn--sm" data-tip="@L["Remove"]" aria-label="@L["Remove"]"
                                                data-confirm="@string.Format(L["Remove the device “{0}”? It gets no more notifications."].Value, device.DeviceName)" data-confirm-ok="@L["Remove"]">
                                            <mm-icon name="trash" />
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </mm-table>
        </mm-list>
    </mm-card>
}

@section Scripts {
    <script src="~/js/account-app.js" asp-append-version="true"></script>
}
