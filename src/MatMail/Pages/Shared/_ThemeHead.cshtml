@model MatMail.Services.ThemeChoice
@* Theme bootstrap for both layouts; render it inside <head> after the stylesheets. The <html> element carries
   data-theme-mode, data-mode, data-accent and data-theme-source (see the layouts). *@
<meta name="theme-color" content="#1a73e8" />
<script>
    // Runs before the first paint: turns the mode into data-mode="light|dark" so the page never flashes the wrong brightness.
    // Without a saved account mode the browser's own choice (localStorage; also used on the sign-in page) wins over the default.
    (function () {
        var root = document.documentElement;
        var mode = root.getAttribute("data-theme-mode") || "system";
        if (root.getAttribute("data-theme-source") !== "user") {
            try {
                var stored = localStorage.getItem("matmail-theme");
                if (stored === "system" || stored === "light" || stored === "dark") { mode = stored; }
            } catch (e) { /* storage unavailable */ }
        }
        var dark = mode === "dark" || (mode === "system" && window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches);
        root.setAttribute("data-theme-mode", mode);
        root.setAttribute("data-mode", dark ? "dark" : "light");
        var meta = document.querySelector('meta[name="theme-color"]');
        var bar = getComputedStyle(root).getPropertyValue("--color-surface").trim();
        if (meta && bar) { meta.setAttribute("content", bar); }
    })();
</script>
