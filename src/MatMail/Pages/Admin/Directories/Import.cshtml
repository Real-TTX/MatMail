@page "/Admin/Directories/Import"
@model MatMail.Pages.Admin.Directories.ImportModel
@{
    ViewData["Breadcrumb"] = "Administration / Directories / Import people";
    ViewData["Title"] = Model.Connection?.Name ?? L["Import people"].Value;
    ViewData["Description"] = L["People of the directory who have no user yet can be made users now, with a mailbox and rights, before they sign in the first time."].Value;
}

<mm-toolbar count="Model.People.Count">
    <mm-toolbar-search name="Search" value="@Model.Search" placeholder='@L["Search name, login or e-mail…"]' />
</mm-toolbar>

<mm-form>
    <div data-selectable>
    <mm-table item-count="Model.People.Count" empty-text='@L["Nobody found."]' empty-icon="users">
        <thead>
            <tr>
                <th scope="col" class="mat-table__select"><input type="checkbox" id="people-all" data-select-all aria-label="@L["Select all"]" /></th>
                <th>@L["Person"]</th>
                <th class="mat-hide-sm">@L["Login name"]</th>
                <th>@L["Status"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.People)
            {
                // Somebody who is a user already, or whose login name belongs to a user of another directory, cannot be chosen; the toolkit's "select all" leaves such a row alone.
                bool selectable = row.State is not (MatMail.Pages.Admin.Directories.ImportModel.PersonState.Imported or MatMail.Pages.Admin.Directories.ImportModel.PersonState.Taken);
                <tr>
                    <td class="mat-table__select">
                        <input type="checkbox" name="Input.Selected" value="@row.Person.Login" data-select-row="@(selectable ? string.Empty : null)"
                               disabled="@(!selectable)" aria-label="@row.Person.DisplayName" />
                    </td>
                    <td>
                        <div class="mat-table__name"><span>@row.Person.DisplayName @if (row.Person.Disabled) { <mm-badge kind="muted">@L["Disabled"]</mm-badge> }<small>@row.Person.Email</small></span></div>
                    </td>
                    <td class="mat-hide-sm">@row.Person.Login</td>
                    <td>
                        @switch (row.State)
                        {
                            case MatMail.Pages.Admin.Directories.ImportModel.PersonState.Imported:
                                <mm-badge kind="ok">@L["Is a user"]</mm-badge>
                                break;
                            case MatMail.Pages.Admin.Directories.ImportModel.PersonState.Local:
                                <mm-badge kind="info">@L["Local user"]</mm-badge>
                                break;
                            case MatMail.Pages.Admin.Directories.ImportModel.PersonState.Taken:
                                <mm-badge kind="warn">@L["Login name in use"]</mm-badge>
                                break;
                            default:
                                <mm-badge kind="muted">@L["New"]</mm-badge>
                                break;
                        }
                    </td>
                </tr>
            }
        </tbody>
    </mm-table>
    </div>
    @if (Model.Truncated)
    {
        <p class="mat-hint">@string.Format(L["The first {0} people are shown. Narrow the search to find the others."].Value, MatMail.Pages.Admin.Directories.ImportModel.Limit)</p>
    }

    <mm-form-section title='@L["What they get"]' icon="user-plus">
        <mm-picker asp-for="Input.RoleIds" asp-items="Model.RoleItems" multiple="true" label='@L["Roles"]'
                   placeholder='@L["Add role…"]' help='@L["Empty: the role “User”."]' />
        <mm-field asp-for="Input.CreateMailbox" kind="checkbox"
                  label='@L["A personal mailbox, with the address of the directory when it is one of the domains of the tenant"]' />
        <mm-field asp-for="Input.SwitchExisting" kind="checkbox"
                  label='@L["People who are local users already (same login name) sign in through the directory from now on: their old password stops working"]' />
    </mm-form-section>

    <mm-button-row>
        <mm-button variant="primary" type="submit" icon="user-plus">@L["Import selected"]</mm-button>
        <mm-button variant="secondary" href="/Admin/Directories/Edit?id=@Model.Id" icon="back">@L["Back"]</mm-button>
    </mm-button-row>
</mm-form>

