@page "/Account/Sessions"
@model MatMail.Pages.Account.SessionsModel
@{
    ViewData["Breadcrumb"] = "Account / Sessions";
    ViewData["Title"] = L["Sessions"].Value;
    ViewData["Description"] = L["Everywhere you are signed in. Sessions stay valid after a restart of the server; end the ones you do not recognise."].Value;
}

<mm-list>
    <mm-table item-count="Model.Sessions.Count" empty-text='@L["No sessions."]' empty-icon="monitor">
        <thead>
            <tr>
                <th>@L["Device"]</th>
                <th class="mat-hide-sm">@L["IP address"]</th>
                <th>@L["Last active"]</th>
                <th class="mat-hide-sm">@L["Signed in"]</th>
                <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var session in Model.Sessions)
            {
                string device = UserAgentInfo.Describe(session.UserAgent);
                <tr>
                    <td>
                        <div class="mat-table__name">
                            <span>@device</span>
                            @if (session.Token == Model.CurrentToken)
                            {
                                <mm-badge kind="ok">@L["This session"]</mm-badge>
                            }
                        </div>
                    </td>
                    <td class="mat-hide-sm mat-mono">@(session.IpAddress ?? "–")</td>
                    <td>@Fmt.Ago(session.LastSeenDate)</td>
                    <td class="mat-hide-sm">@Fmt.DateTimeText(session.CreateDate)</td>
                    <td class="mat-table__cell-actions">
                        <div class="mat-table__actions">
                            @if (session.Token != Model.CurrentToken)
                            {
                                <form method="post" asp-page-handler="Revoke" data-no-busy>
                                    <input type="hidden" name="token" value="@session.Token" />
                                    <button type="submit" class="mat-btn mat-btn--danger mat-btn--icon mat-btn--sm" data-tip="@L["Sign out"]" aria-label="@L["Sign out"]"
                                            data-confirm="@string.Format(L["Sign out the session “{0}”?"].Value, device)" data-confirm-ok="@L["Sign out"]">
                                        <mm-icon name="logout" />
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </mm-table>

    @if (Model.Sessions.Count > 1)
    {
        <mm-list-actions>
            <form method="post" asp-page-handler="RevokeOthers">
                <mm-button variant="danger" type="submit" icon="logout" confirm='@L["Sign out all other sessions?"]' confirm-ok='@L["Sign out"]'>@L["Sign out all other sessions"]</mm-button>
            </form>
        </mm-list-actions>
    }
</mm-list>
