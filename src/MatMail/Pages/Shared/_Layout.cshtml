@inject CurrentUser CurrentUser
@inject ThemeService Themes
@inject BrandingService Branding
@inject TenantService TenantSvc
@inject Toolkit Toolkit
@inject ShellMenus Menus
@using Microsoft.AspNetCore.Html
@{
    // A page fills these in: Title (else the last crumb), Breadcrumb ("Section / Page", every segment is translated; BreadcrumbLiteral: they are names),
    // Description (one line under the title), ActiveHref (the menu item it belongs to when its address is not one of the menu), Width ("narrow" or
    // "wide"), NoHeading (it draws its own head) and Area ("mail": the web client, which fills the whole area).
    var theme = Themes.Resolve();
    Brand brand = await Branding.GetAsync(CurrentUser.TenantId);
    string productName = brand.Name ?? "MatMail";
    string path = Context.Request.Path.Value ?? "/";
    var isMail = ViewData["Area"] as string == "mail";

    // The accent: the user's own choice wins, then the colour of the tenant, then the installation's default, then the colour of the app.
    string? preset = theme.Accent == "default" ? null : theme.Accent;
    string? accent = theme.UserHasAccent ? preset : brand.AccentColor is not null ? "custom" : preset;
    string? brandColor = accent == "custom" ? brand.AccentColor : null;

    // Breadcrumbs are "Section / Page" strings; each segment is translated, the last one is the page. They mirror the URL, so
    // every crumb but the last can link back (only when both have the same number of segments).
    var crumbText = ViewData["Breadcrumb"] as string ?? "";
    var literalCrumbs = ViewData["BreadcrumbLiteral"] is true;
    var crumbs = crumbText.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Select(s => literalCrumbs ? s : L[s].Value).ToList();
    var pathParts = path.Split('/', StringSplitOptions.RemoveEmptyEntries).ToList();
    var crumbsLinkable = pathParts.Count == crumbs.Count && crumbs.Count > 1;

    var pageTitle = ViewData["Title"] as string is { Length: > 0 } given && !string.IsNullOrWhiteSpace(given) ? given : (crumbs.Count > 0 ? crumbs[^1] : productName);
    var showHeading = ViewData["NoHeading"] is not true && !isMail;
    var pageDescription = ViewData["Description"] as string;
    var width = ViewData["Width"] as string;

    var menus = Menus.ForUser();
    var current = ShellMenus.Current(menus, path);
    var active = ViewData["ActiveHref"] as string ?? ShellMenus.ActiveHref(menus, path);
    var hasSwitcher = menus.Count > 1;

    var head = new HeadModel(pageTitle == productName ? productName : pageTitle + " · " + productName, productName, brandColor, isMail);
    var displayName = CurrentUser.DisplayName ?? CurrentUser.Username ?? "?";
    var switchableTenants = await TenantSvc.ListSwitchableAsync();
    var culture = global::System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    // An entry of the popup of the switcher. A menu with a start page is a link: the page that loads draws its own menu (a button would only swap the items).
    void MenuEntry(NavSet menu)
    {
        <a class="mat-menu__item" href="@menu.Href" role="menuitemradio" aria-checked="@(menu == current ? "true" : "false")" data-nav-set="@menu.Id" data-nav-title="@menu.Title" @(menu.NeedsAttention ? Html.Raw("data-nav-attention") : null)>
            @Toolkit.Icon(menu.Icon)<span>@menu.Title</span>
            @if (menu.NeedsAttention) { <span class="mat-nav__badge mat-nav__badge--dot mat-nav__badge--warn"><span class="mat-sr-only">@L["needs attention"]</span></span> }
            @Toolkit.Icon("check", "mat-menu__check")
        </a>
    }

    IHtmlContent Badge(NavBadge badge, bool sum = false)
    {
        var text = badge.IsDot ? string.Empty : badge.Text;
        var label = string.IsNullOrEmpty(badge.Label) ? string.Empty : (badge.IsDot ? badge.Label : " " + badge.Label);
        return new HtmlString($"<span class=\"{badge.Classes(sum)}\">{Ui.Encode(text)}" + (label.Length == 0 ? string.Empty : $"<span class=\"mat-sr-only\">{Ui.Encode(label)}</span>") + "</span>");
    }
}
<!DOCTYPE html>
<html lang="@culture" data-app="matmail" data-theme="@(theme.UserHasMode || theme.Mode != "system" ? theme.Mode : null)" data-accent="@accent" data-text-size="@theme.TextSize" data-density="@theme.Density" data-previews="@(theme.ShowPreviews ? "on" : "off")" data-reading-pane="@theme.ReadingPane" data-conversations="@(theme.ConversationView ? "on" : "off")" data-time-zone="@theme.UserTimeZone" @Toolkit.LanguageAttributes(L)>
<head>
    <partial name="_Head" model="head" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="mat-skip" href="#main">@L["Skip to the content"]</a>
    @Html.Raw(Toolkit.Sprite)

    <div class="mat-app" data-area="@(isMail ? "mail" : "page")">
        <aside class="mat-nav" id="mat-nav">
            <div class="mat-nav__brand">
                <a href="/" aria-label="@productName">
                    @if (brand.LogoUrl is { } logoUrl)
                    {
                        <img class="mm-brand-logo" src="@logoUrl" alt="@productName" />
                    }
                    else
                    {
                        <span class="mat-logo" aria-hidden="true"><img src="~/icons/mark.svg" alt="" /></span>
                        <span class="mat-nav__name">@productName</span>
                    }
                </a>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-nav__close" data-nav-close aria-label="@L["Close"]">@Toolkit.Icon("x")</button>
            </div>

            @* A menu with a start page has a panel only while it is the current one: choosing it in the switcher loads its page *@
            @foreach (var menu in menus.Where(m => m == current || !m.HasStartPage))
            {
                <nav class="mat-nav__scroll" aria-label="@(hasSwitcher ? menu.Title : L["Main navigation"].Value)" data-nav-panel="@menu.Id" hidden="@(menu != current)">
                    @if (menu.Custom && menu == current && IsSectionDefined("Sidebar"))
                    {
                        @* The mail client draws its own folders (mail-ui.js) *@
                        @await RenderSectionAsync("Sidebar")
                    }
                    else
                    {
                        <ul class="mat-nav__list">
                            @foreach (var group in menu.Groups)
                            {
                                if (group.Title is not null)
                                {
                                    <li class="mat-nav__group" role="presentation">@group.Title</li>
                                }

                                foreach (var item in group.Items)
                                {
                                    if (item.IsParent)
                                    {
                                        var hasActive = item.Contains(active);
                                        var subId = $"nav-sub-{menu.Id}-{item.Key}";
                                        var sum = item.SumOfChildren;
                                        <li class="mat-nav__branch @(hasActive ? "is-open is-current" : "")">
                                            <button type="button" class="mat-nav__item mat-nav__parent" aria-expanded="@(hasActive ? "true" : "false")" aria-controls="@subId" data-nav-branch="@item.Key">
                                                @if (item.Icon is not null) { @Toolkit.Icon(item.Icon) }<span>@item.Title</span>
                                                @if (item.Badge is not null) { @Badge(item.Badge) }
                                                else if (sum is not null) { @Badge(sum, sum: true) }
                                                @Toolkit.Icon("chevron-down", "mat-nav__chev")
                                            </button>
                                            <div class="mat-nav__sub" id="@subId">
                                                <ul class="mat-nav__list">
                                                    @foreach (var child in item.Children!)
                                                    {
                                                        var childActive = child.Href == active;
                                                        <li>
                                                            <a class="mat-nav__item mat-nav__item--sub @(childActive ? "is-active" : "")" href="@child.Href" aria-current="@(childActive ? "page" : null)">
                                                                <span>@child.Title</span>
                                                                @if (child.Badge is not null) { @Badge(child.Badge) }
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </li>
                                    }
                                    else
                                    {
                                        var isActive = item.Href == active;
                                        <li>
                                            <a class="mat-nav__item @(isActive ? "is-active" : "")" href="@item.Href" aria-current="@(isActive ? "page" : null)">
                                                @if (item.Icon is not null) { @Toolkit.Icon(item.Icon) }<span>@item.Title</span>
                                                @if (item.Badge is not null) { @Badge(item.Badge) }
                                            </a>
                                        </li>
                                    }
                                }
                            }
                        </ul>
                    }
                </nav>
            }

            <div class="mat-nav__foot">
                @if (hasSwitcher)
                {
                    <div class="mat-nav__switch mat-nav__switch--foot">
                        <button type="button" class="mat-switcher" data-menu-toggle="nav-switch-menu" data-menu-place="top" aria-haspopup="menu" aria-expanded="false">
                            <span class="mat-switcher__icon">@Toolkit.Icon(current.Icon)</span>
                            <span class="mat-switcher__text"><small>@L["Menu"]</small><span class="mat-switcher__name">@current.Title</span></span>
                            @Toolkit.Icon("chevron-up", "mat-switcher__chev")
                            <span class="mat-switcher__dot" hidden="@(!menus.Any(m => m != current && m.NeedsAttention))"></span>
                        </button>
                    </div>
                }
                <div class="mat-nav__account">
                    <button type="button" class="mat-user" data-menu-toggle="user-menu" aria-haspopup="menu" aria-expanded="false">
                        <span class="mat-avatar" aria-hidden="true">@Ui.Initials(displayName)</span>
                        <span class="mat-user__text">
                            <span class="mat-user__name">@displayName</span>
                            <span class="mat-user__role">@(CurrentUser.TenantName ?? "")</span>
                        </span>
                        @Toolkit.Icon("chevron-up", "mat-user__chev")
                    </button>
                    <button type="button" class="mat-theme" data-theme-toggle data-theme-save-url="/Account/Appearance?handler=Mode" data-theme-state="@theme.Mode" aria-label="@L["Theme"]" title="@L["Theme"]" data-t-label="@L["Theme: {0}. Click for {1}."]" data-t-system="@L["System"]" data-t-light="@L["Light"]" data-t-dark="@L["Dark"]">
                        <svg class="mat-icon" data-theme-icon="system" aria-hidden="true" focusable="false"><use href="#mat-i-monitor"></use></svg>
                        <svg class="mat-icon" data-theme-icon="light" aria-hidden="true" focusable="false"><use href="#mat-i-sun"></use></svg>
                        <svg class="mat-icon" data-theme-icon="dark" aria-hidden="true" focusable="false"><use href="#mat-i-moon"></use></svg>
                    </button>
                </div>
                <div class="mat-nav__version">MatMail @AppInfo.Version</div>
            </div>
        </aside>

        <div class="mat-main">
            <header class="mat-topbar">
                <button type="button" class="mat-burger" data-nav-toggle aria-label="@L["Toggle navigation"]" aria-controls="mat-nav" aria-expanded="false">@Toolkit.Icon("menu")</button>
                <nav class="mat-crumbs" aria-label="@L["Breadcrumb"]">
                    <ol>
                        @if (crumbs.Count == 0)
                        {
                            <li aria-current="page">@productName</li>
                        }
                        else
                        {
                            for (var i = 0; i < crumbs.Count; i++)
                            {
                                if (crumbsLinkable && i < crumbs.Count - 1)
                                {
                                    <li><a href="/@string.Join("/", pathParts.Take(i + 1))">@crumbs[i]</a></li>
                                }
                                else if (i == crumbs.Count - 1)
                                {
                                    <li aria-current="page">@crumbs[i]</li>
                                }
                                else
                                {
                                    <li>@crumbs[i]</li>
                                }
                            }
                        }
                    </ol>
                </nav>
                @if (IsSectionDefined("HeaderCenter"))
                {
                    @* What belongs to the whole page and not to one place in it (the search of the mail client) stands at the right end of the bar (SHELL-17). *@
                    <div class="mat-topbar__actions mm-topbar-tools">@await RenderSectionAsync("HeaderCenter")</div>
                }
            </header>

            <main class="mat-page @(width == "narrow" ? "mat-page--narrow" : width == "wide" ? "mat-page--wide" : "") @(isMail ? "mm-flush" : "")" id="main">
                <partial name="_Notice" />
                @if (showHeading)
                {
                    <div class="mat-page__head">
                        <div class="mat-page__title">
                            <h1>@pageTitle</h1>
                            @if (!string.IsNullOrEmpty(pageDescription))
                            {
                                <p class="mat-page__sub">@pageDescription</p>
                            }
                        </div>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <div class="mat-menu" id="user-menu" role="menu" aria-label="@displayName" hidden>
        <div class="mat-menu__head">
            <span class="mat-avatar" aria-hidden="true">@Ui.Initials(displayName)</span>
            <div><strong>@displayName</strong><small>@CurrentUser.Username@(string.IsNullOrEmpty(CurrentUser.TenantName) ? "" : " · " + CurrentUser.TenantName)</small></div>
        </div>
        <a class="mat-menu__item" role="menuitem" href="/Account">@Toolkit.Icon("user")<span>@L["My account"]</span></a>
        <a class="mat-menu__item" role="menuitem" href="/Account/Appearance">@Toolkit.Icon("sliders")<span>@L["Appearance and language"]</span></a>
        <a class="mat-menu__item" role="menuitem" href="/Account/MailPrograms">@Toolkit.Icon("server")<span>@L["IMAP / SMTP settings"]</span></a>
        @if (CurrentUser.Can(Permissions.MailUse))
        {
            <a class="mat-menu__item" role="menuitem" href="/Account/Rules">@Toolkit.Icon("filter")<span>@L["Mail rules"]</span></a>
            @* Fetches every connected account that feeds the mailboxes of this user (matmail.js). *@
            <button type="button" class="mat-menu__item" role="menuitem" data-sync-now
                    data-t-busy='@L["Synchronising…"]' data-t-none='@L["No connected account delivers into your mailboxes."]'
                    data-t-done='@L["Synchronised: {0} new message(s)."]' data-t-nonew='@L["Synchronised: no new messages."]'
                    data-t-running='@L["{0} account(s) are still being fetched; the mail appears as soon as they are done."]'
                    data-t-failed='@L["{0} account(s) could not be synchronised."]' data-t-error='@L["The synchronisation could not be started."]'>
                @Toolkit.Icon("refresh")<span class="mm-sync-label">@L["Synchronise now"]</span>
            </button>
        }
        <div class="mat-menu__sep" role="separator"></div>
        <form method="post" action="/Account/Logout" class="mm-menu-form">
            @Html.AntiForgeryToken()
            <button type="submit" class="mat-menu__item mat-menu__item--danger" role="menuitem">@Toolkit.Icon("logout")<span>@L["Sign out"]</span></button>
        </form>
    </div>

    @if (hasSwitcher)
    {
        <div class="mat-menu" id="nav-switch-menu" role="menu" aria-label="@L["Menus"]" data-nav-scope="mat-nav" hidden>
            @foreach (var menu in menus.Where(m => !m.Last))
            {
                MenuEntry(menu);
            }
            @if (switchableTenants.Count > 1)
            {
                @* System administrators work in one tenant at a time: the tenants are a closed parent between the menus and the administration (SHELL-15), a form button each *@
                <button type="button" class="mat-menu__item mat-menu__parent" role="menuitem" aria-expanded="false" aria-controls="nav-switch-choices-tenants" data-nav-group>
                    @Toolkit.Icon("building")<span>@L["Tenants"]</span>@Toolkit.Icon("chevron-down", "mat-menu__chev")
                </button>
                <div class="mat-menu__sub" id="nav-switch-choices-tenants" role="group" aria-label="@L["Tenants"]" hidden>
                    @foreach (var tenant in switchableTenants)
                    {
                        <form method="post" action="/Account/SwitchTenant" class="mat-menu__form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="tenantId" value="@tenant.Id" />
                            <input type="hidden" name="returnUrl" value="@(isMail ? "/Mail" : "/Admin")" />
                            <button type="submit" class="mat-menu__item mat-menu__item--sub" role="menuitemradio" aria-checked="@(tenant.Id == CurrentUser.TenantId ? "true" : "false")">
                                <span>@tenant.Name</span>@Toolkit.Icon("check", "mat-menu__check")
                            </button>
                        </form>
                    }
                </div>
            }
            @foreach (var menu in menus.Where(m => m.Last))
            {
                MenuEntry(menu);
            }
        </div>
    }

    <script src="~/matui/matui.js" asp-append-version="true"></script>
    <script src="~/js/matmail.js" asp-append-version="true"></script>
    <script src="~/js/pwa.js" asp-append-version="true" data-worker="/sw.js?v=@AppInfo.Version"></script>
    <script src="~/js/rte.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
