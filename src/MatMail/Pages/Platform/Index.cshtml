@page "/Platform"
@model MatMail.Pages.Platform.IndexModel
@{
    ViewData["Breadcrumb"] = "Platform";
    ViewData["Title"] = L["Platform"].Value;
    ViewData["Description"] = L["The whole installation: every tenant and what is in it. The lists in the menu show everything of all tenants at once; a row opens in its tenant."].Value;
    string openLabel = L["Open the administration of this tenant"].Value;
}

<div class="mat-cols">
    <mm-card class="mat-col-12" title='@L["Server"]' icon="server">
        <dl class="mat-kv">
            <dt>@L["Version"]</dt><dd class="mat-mono">@AppInfo.Version</dd>
            <dt>@L["Host name"]</dt><dd>@Model.Hostname</dd>
            <dt>@L["Started"]</dt><dd>@Fmt.DateTimeText(AppInfo.StartedAt)</dd>
            <dt>@L["Certificate"]</dt>
            <dd>
                @if (Model.Certificate is { } cert)
                {
                    <div>@cert.Subject</div>
                    <div class="mat-muted">
                        @if (cert.IsSelfSigned) { <mm-badge kind="warn">@L["Self-signed"]</mm-badge> }
                        @string.Format(L["valid until {0}"].Value, Fmt.DateText(cert.NotAfter))
                    </div>
                }
                else
                {
                    <mm-badge kind="danger">@L["None"]</mm-badge>
                }
            </dd>
            <dt>@L["Backup"]</dt>
            <dd>
                @if (Model.Backup.Plans == 0)
                {
                    <a href="/Platform/Backup"><mm-badge kind="warn">@L["Not scheduled"]</mm-badge></a>
                }
                else if (Model.Backup.Failed)
                {
                    <a href="/Platform/Backup"><mm-badge kind="danger">@L["The last backup failed"]</mm-badge></a>
                }
                else if (Model.Backup.LastBackup is { } last && last > DateTime.UtcNow.AddDays(-2))
                {
                    <a href="/Platform/Backup"><mm-badge kind="ok">@Fmt.Ago(last)</mm-badge></a>
                }
                else
                {
                    <a href="/Platform/Backup"><mm-badge kind="warn">@(Model.Backup.LastBackup is null ? L["No backup yet"].Value : string.Format(L["Last: {0}"].Value, Fmt.Ago(Model.Backup.LastBackup)))</mm-badge></a>
                }
            </dd>
        </dl>
    </mm-card>
</div>

<mm-table item-count="Model.Rows.Count" empty-text='@L["No tenants yet."]' empty-icon="building">
    <thead>
        <tr>
            <th>@L["Tenant"]</th>
            <th class="mat-num">@L["Users"]</th>
            <th class="mat-num mat-hide-sm">@L["Members"]</th>
            <th class="mat-num mat-hide-sm">@L["Mailboxes"]</th>
            <th class="mat-num mat-hide-sm">@L["Domains"]</th>
            <th>@L["Connected accounts"]</th>
            <th scope="col"><span class="mat-sr-only">@L["Actions"]</span></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var tenant in Model.Rows)
        {
            <tr data-row-submit>
                <td>
                    <div class="mat-table__name"><span><partial name="_OpenInTenant" model='new OpenInTenant(tenant.Id, "/Admin", tenant.Name)' />@if (!tenant.IsActive) { <mm-badge kind="muted">@L["Inactive"]</mm-badge> }</span></div>
                </td>
                <td class="mat-num">@tenant.Users</td>
                <td class="mat-num mat-hide-sm">@tenant.Members</td>
                <td class="mat-num mat-hide-sm">@tenant.Mailboxes</td>
                <td class="mat-num mat-hide-sm">@tenant.Domains</td>
                <td>
                    <span>@tenant.Accounts</span>
                    @if (tenant.AccountErrors > 0) { <mm-badge kind="danger">@L["{0} failing", tenant.AccountErrors]</mm-badge> }
                </td>
                <td class="mat-table__cell-actions">
                    <div class="mat-table__actions"><partial name="_OpenInTenant" model='new OpenInTenant(tenant.Id, "/Admin", openLabel, OpenInTenant.OpenIcon)' /></div>
                </td>
            </tr>
        }
    </tbody>
</mm-table>
